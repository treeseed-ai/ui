---
import Button from '../forms/actions/Button.astro';
import KeyValueList from '../data/KeyValueList.astro';
import PageHeader from '../layout/PageHeader.astro';
import EmptyState from '../surface/EmptyState.astro';
import Panel from '../surface/Panel.astro';
import ResourceCard from '../surface/ResourceCard.astro';
import ModeNavigation from '../shell/navigation/ModeNavigation.astro';
import type { Tone } from '../types.ts';

interface Props { activeTeam: boolean; projectId: string; project: any; summary: any; agents: any; capacity: any; releases: any; repository: any; approvals: any[] }
const { activeTeam, projectId, project, summary, agents, capacity, releases, repository, approvals } = Astro.props as Props;
const text = (...values: unknown[]) => String(values.find((value) => typeof value === 'string' && value.trim()) ?? '');
const tone = (value: unknown): Tone => ['failed', 'blocked', 'rejected'].includes(String(value)) ? 'danger' : ['ready', 'active', 'approved'].includes(String(value)) ? 'success' : 'default';
const rows = (value: any) => Array.isArray(value) ? value : Array.isArray(value?.items) ? value.items : [];
---
<section class="ts-template" aria-label="Project command overview" data-scene="command.project.overview"><PageHeader eyebrow="Command · Project" title={text(project.displayName, project.name, 'Project unavailable')} description={text(project.description, summary.description, 'Operational project context.')}><Button slot="actions" href="/app/projects" variant="secondary">Portfolio</Button><Button slot="actions" href={`/app/projects/${encodeURIComponent(projectId)}/agents`}>Inspect agents</Button></PageHeader><ModeNavigation mode="command" current="projects" />
	{!activeTeam ? <EmptyState title="Choose an active team" description="Project command is team-scoped." /> : !project.id ? <EmptyState title="Project not found" description="The project is unavailable or outside the active team." /> : <>
		<div class="ts-resource-grid"><Panel eyebrow="Operating state" title={String(project.status ?? 'active')} description="Current project posture and pending governance."><KeyValueList items={[{ key: 'Project ID', value: String(project.id) }, { key: 'Approvals', value: approvals.length }, { key: 'Agent classes', value: Number(agents.count ?? rows(agents.agents).length) }, { key: 'Release state', value: text(releases.status, 'No active release') }]} /></Panel><Panel eyebrow="Capacity" title={text(capacity.status, 'Capacity summary')} description={text(capacity.summary, 'Inspect team-level reservations, usage, and provider availability.')}><Button href={`/app/capacity?projectId=${encodeURIComponent(projectId)}`} variant="secondary">Open capacity</Button></Panel></div>
		<Panel eyebrow="Situations" title="Project attention queue" description="Existing approvals and release evidence become visible operational conditions.">{approvals.map((approval) => <ResourceCard title={text(approval.title, 'Approval required')} description={text(approval.summary, approval.reason, 'Work is waiting for judgment.')} status={String(approval.status ?? 'pending')} tone={tone(approval.status)} href="/app/focus/proposals" />)}{!approvals.length ? <p>No pending approval records were returned.</p> : null}</Panel>
		<Panel eyebrow="Repository and delivery" title="Execution context" description="Repository topology and release state remain read-only projections on this surface."><pre class="ts-code-block">{JSON.stringify({ repository, releases }, null, 2)}</pre></Panel>
	</>}
</section>
