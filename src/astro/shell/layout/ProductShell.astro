---
import ShellFrame from './ShellFrame.astro';
import ShellHeader from '../chrome/ShellHeader.astro';
import SiteUserControls from '../chrome/SiteUserControls.astro';
import TeamOperationsPanel from '../team-operations/TeamOperationsPanel.astro';
import TeamOperationsDrawer from '../team-operations/TeamOperationsDrawer.astro';
import ControlSurface from './ControlSurface.astro';
import type { ButtonAction, ShellBrand, ShellNavItem, SiteUserControlItem } from '../../types.ts';
import type { FeedbackContext, HelpContext } from '../../../lib/foundation/contracts.ts';
import type { ThemePreference, ThemeConfig } from '../../../theme/index.ts';

// FeedbackButton, FeedbackDialog, HelpButton, and HelpDrawer are composed through SiteUserControls and ShellFrame.

interface Props {
	title: string;
	description: string;
	currentPath: string;
	appearance: ThemePreference;
	brand: ShellBrand;
	navItems: ShellNavItem[];
	siteItems?: SiteUserControlItem[];
	quickActions?: ButtonAction[];
	accountActions?: ButtonAction[];
	bottomNavItems?: ShellNavItem[];
	themeConfig?: ThemeConfig;
	helpContext?: HelpContext;
	feedbackContext?: FeedbackContext;
	contentOwnsPageHeader?: boolean;
	timeZone?: string;
}

const {
	title,
	description,
	currentPath,
	appearance,
	brand,
	navItems,
	siteItems = [
		{ label: 'Home', href: '/' },
		{ label: 'Market', href: '/market/' },
		{ label: 'Knowledge', href: '/knowledge/' },
	],
	quickActions = [],
	accountActions = [],
	themeConfig,
	helpContext,
	feedbackContext,
	contentOwnsPageHeader = false,
	timeZone = 'UTC',
} = Astro.props as Props;
const feedbackDialogId = 'product-shell-feedback';
const helpDrawerId = 'product-shell-help';
const drawerId = 'team-operations-drawer';
const sidebarId = 'team-operations-sidebar';
---

<ShellFrame
	title={title}
	description={description}
	appearance={appearance}
	themeConfig={themeConfig}
	helpContext={helpContext}
	feedbackContext={feedbackContext}
	helpDrawerId={helpDrawerId}
	feedbackDialogId={feedbackDialogId}
	bodyClass="ts-product-shell-body"
	timeZone={timeZone}
>
	<script is:inline slot="head">
		(() => {
			const storageKey = 'treeseed.app-sidebar-collapsed';
			const readState = () => {
				try {
					return localStorage.getItem(storageKey) === 'true' ? 'collapsed' : 'expanded';
				} catch {
					return 'expanded';
				}
			};
			const prepare = (root) => {
				root.dataset.tsAppSidebar = readState();
				root.dataset.tsAppSidebarReady = 'true';
			};

			prepare(document.documentElement);
			if (!window.__tsAppSidebarBeforeSwapBound) {
				window.__tsAppSidebarBeforeSwapBound = true;
				document.addEventListener('astro:before-swap', (event) => {
					prepare(event.newDocument.documentElement);
				});
			}
		})();
	</script>
	<div class="ts-product-shell" data-scene="app-shell" data-page-header-owner={contentOwnsPageHeader ? 'content' : 'shell'}>
		<div class="ts-product-shell__header">
			<ShellHeader brand={brand} showMenuButton menuTargetId={drawerId}>
				<Fragment slot="actions">
					<SiteUserControls
						items={siteItems}
						currentPath={currentPath}
						appearance={appearance}
						themeConfig={themeConfig}
						helpContext={helpContext}
						feedbackContext={feedbackContext}
						helpDrawerId={helpDrawerId}
						feedbackDialogId={feedbackDialogId}
						showHomeLink
					/>
				</Fragment>
			</ShellHeader>
		</div>
		<div class="ts-product-shell__body">
			<div class="ts-product-shell__desktop-operations">
				<TeamOperationsPanel id={sidebarId} items={navItems} currentPath={currentPath} quickActions={quickActions} accountActions={accountActions} collapsible>
					<Fragment slot="teamSelector"><slot name="railContext" /></Fragment>
				</TeamOperationsPanel>
			</div>
			<ControlSurface title={contentOwnsPageHeader ? undefined : title} description={contentOwnsPageHeader ? undefined : description}>
				{Astro.slots.has('headerAction') ? (
					<Fragment slot="actions"><slot name="headerAction" /></Fragment>
				) : null}
				<slot name="projectContext" />
				<slot />
			</ControlSurface>
		</div>
	</div>
	<TeamOperationsDrawer id={drawerId}>
		<TeamOperationsPanel items={navItems} currentPath={currentPath} quickActions={quickActions} accountActions={accountActions}>
			<Fragment slot="teamSelector"><slot name="railContext" /></Fragment>
		</TeamOperationsPanel>
		<SiteUserControls
			items={siteItems}
			currentPath={currentPath}
			appearance={appearance}
			themeConfig={themeConfig}
			helpContext={helpContext}
			feedbackContext={feedbackContext}
			helpDrawerId={helpDrawerId}
			feedbackDialogId={feedbackDialogId}
			showHomeLink
		/>
	</TeamOperationsDrawer>
	<slot name="sensitiveModal" />
	<slot name="modal" />
	<script is:inline data-astro-rerun>
		(() => {
			const storageKey = 'treeseed.app-sidebar-collapsed';
			const root = document.documentElement;

			const apply = (collapsed) => {
				root.dataset.tsAppSidebar = collapsed ? 'collapsed' : 'expanded';
				document.querySelectorAll('[data-ts-app-sidebar-toggle]').forEach((toggle) => {
					if (!(toggle instanceof HTMLButtonElement)) return;
					const label = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
					toggle.setAttribute('aria-expanded', String(!collapsed));
					toggle.setAttribute('aria-label', label);
					toggle.title = label;
					const visibleLabel = toggle.querySelector('[data-ts-sidebar-toggle-label]');
					if (visibleLabel) visibleLabel.textContent = label;
				});
			};

			const read = () => {
				try {
					return localStorage.getItem(storageKey) === 'true';
				} catch {
					return false;
				}
			};

			apply(read());
			if (!window.__tsAppSidebarToggleBound) {
				window.__tsAppSidebarToggleBound = true;
				document.addEventListener('click', (event) => {
					const target = event.target instanceof Element
						? event.target.closest('[data-ts-app-sidebar-toggle]')
						: null;
					if (!(target instanceof HTMLButtonElement)) return;
					const collapsed = root.dataset.tsAppSidebar !== 'collapsed';
					apply(collapsed);
					try {
						localStorage.setItem(storageKey, String(collapsed));
					} catch {
						// Storage is optional; the in-page state remains usable.
					}
				});
			}
		})();
	</script>
</ShellFrame>
