---
import '../../../styles/tokens.css';
import '../../../styles/theme.css';
import '../../../styles/ui.css';
import '../../../styles/forms.css';
import '../../../styles/app-shell.css';
import '../../../styles/discussion.css';
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../../theme/ThemeScript.astro';
import FeedbackPanel from '../../feedback/FeedbackPanel.astro';
import DiscussionPanel from '../../discussion/DiscussionPanel.astro';
import ToastRegion from '../../feedback/ToastRegion.astro';
import HelpDialog from '../../help/HelpDialog.astro';
import type { DiscussionContext, FeedbackContext, HelpContext } from '../../../lib/foundation/contracts.ts';
import type { ThemePreference, ThemeConfig, WorkspaceThemePreference } from '../../../theme/index.ts';
import { SessionConnectionIsland } from '../../../react/progressive/index.ts';

interface Props {
	title: string;
	description?: string;
	appearance: ThemePreference;
	themeConfig?: ThemeConfig;
	helpContext?: HelpContext;
	feedbackContext?: FeedbackContext;
	discussionContext?: DiscussionContext;
	helpDrawerId?: string;
	feedbackDialogId?: string;
	discussionDialogId?: string;
	bodyClass?: string;
	preferServerAppearance?: boolean;
	timeZone?: string;
	workspaceTheme?: WorkspaceThemePreference;
}

const {
	title,
	description = 'TreeSeed',
	appearance,
	themeConfig,
	helpContext,
	feedbackContext,
	discussionContext,
	helpDrawerId = 'shell-help',
	feedbackDialogId = 'shell-feedback',
	discussionDialogId = 'shell-discussion',
	bodyClass,
	preferServerAppearance = false,
	timeZone = 'UTC',
	workspaceTheme,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" data-ts-time-zone={timeZone}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
		<ThemeScript
			defaultScheme={appearance.scheme}
			defaultMode={appearance.mode}
			preferDefaultPreference={preferServerAppearance}
			themeConfig={themeConfig}
			workspace={workspaceTheme}
		/>
		<ClientRouter />
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<a class="ts-skip-link" href="#main-content">Skip to content</a>
		<div class="ts-shell-workspace" data-ts-shell-workspace>
			<div class="ts-shell-workspace__content"><slot /></div>
			{feedbackContext ? <FeedbackPanel id={feedbackDialogId} context={feedbackContext} /> : null}
			{discussionContext ? <DiscussionPanel id={discussionDialogId} context={discussionContext} /> : null}
		</div>
		{discussionContext?.realtime ? <SessionConnectionIsland teamId={discussionContext.teamId} endpoint={discussionContext.realtime.endpoint} enabled={discussionContext.realtime.enabled} client:only="react" transition:persist="session-connection" /> : null}
		{helpContext ? <HelpDialog id={helpDrawerId} context={helpContext} feedbackTargetId={feedbackContext ? feedbackDialogId : undefined} feedbackContext={feedbackContext} /> : null}
		<ToastRegion />
		<slot name="bodyEnd" />
		<script>
			import { formatTimestampElements } from '../../../timestamps.ts';
			const renderTimestamps = () => formatTimestampElements(document);
			document.addEventListener('astro:page-load', renderTimestamps);
			document.addEventListener('treeseed:content-updated', renderTimestamps);
			renderTimestamps();
		</script>
	</body>
</html>
