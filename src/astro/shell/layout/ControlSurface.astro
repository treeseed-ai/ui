---
interface Props {
	title?: string;
	description?: string;
	class?: string;
	renderActions?: boolean;
	workspaceTheme?: { enabled: boolean; scheme: string; mode: string };
}

const { title, description, class: className, renderActions = Astro.slots.has('actions'), workspaceTheme } = Astro.props as Props;
---

<main
	class:list={['ts-control-surface', className]}
	id="main-content"
	data-ts-workspace-scope
	data-ts-workspace-theme={workspaceTheme?.enabled ? 'true' : undefined}
	data-ts-workspace-scheme={workspaceTheme?.scheme}
	data-ts-workspace-mode={workspaceTheme?.mode}
>
	{title || description || renderActions ? (
		<header class="ts-control-surface__header">
			<div class="ts-control-surface__title">
				{title ? <h1>{title}</h1> : null}
				{description ? <p>{description}</p> : null}
			</div>
			{renderActions ? <div class="ts-control-surface__actions"><slot name="actions" /></div> : null}
		</header>
	) : null}
	{Astro.slots.has('tabs') ? <div class="ts-control-surface__tabs"><slot name="tabs" /></div> : null}
	<div class="ts-control-surface__body">
		<slot />
	</div>
</main>
