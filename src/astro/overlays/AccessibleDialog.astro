---
interface Props { id: string; title: string; description?: string; }
const { id, title, description } = Astro.props as Props;
---

<dialog id={id} class="ts-dialog" aria-labelledby={`${id}-title`} aria-describedby={description ? `${id}-description` : undefined} data-ts-dialog data-ts-dialog-backdrop-close>
	<div class="ts-dialog__surface">
		<header class="ts-dialog__header"><div><h2 id={`${id}-title`}>{title}</h2>{description ? <p id={`${id}-description`}>{description}</p> : null}</div><button type="button" class="ts-icon-button" data-dialog-close data-ts-dialog-initial-focus aria-label="Close dialog">Close</button></header>
		<div class="ts-dialog__body"><slot /></div>
	</div>
</dialog>

<script>
	import { initializeDialogController } from '../../lib/overlays/dialog-controller.ts';
	initializeDialogController();
</script>
