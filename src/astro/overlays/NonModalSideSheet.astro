---
interface Props {
	id: string;
	labelledBy: string;
	describedBy?: string;
	class?: string;
	scene?: string;
	applicationId?: string;
}

const { id, labelledBy, describedBy, class: className, scene, applicationId } = Astro.props as Props;
---

<aside
	id={id}
	class:list={['ts-side-sheet', className]}
	role="dialog"
	aria-modal="false"
	aria-labelledby={labelledBy}
	aria-describedby={describedBy}
	data-ts-side-sheet
	data-ts-feedback-panel={scene === 'feedback.panel' ? '' : undefined}
	data-ts-utility-application={applicationId}
	data-scene={scene}
	popover="manual"
	hidden
>
	<div class="ts-side-sheet__resize" role="separator" aria-label="Resize utility application" aria-orientation="vertical" tabindex="0" data-ts-utility-resize></div>
	<header class="ts-side-sheet__header"><slot name="header" /></header>
	<div class="ts-side-sheet__body"><slot /></div>
	{Astro.slots.has('footer') ? <footer class="ts-side-sheet__footer"><slot name="footer" /></footer> : null}
</aside>
