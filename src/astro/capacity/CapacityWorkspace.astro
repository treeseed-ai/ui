---
import Button from '../forms/actions/Button.astro';
import MetricCard from '../data/metrics/MetricCard.astro';
import MetricGrid from '../data/metrics/MetricGrid.astro';
import PageHeader from '../layout/PageHeader.astro';
import ModeNavigation from '../shell/navigation/ModeNavigation.astro';
import SemanticCollectionSurface from '../semantic/SemanticCollectionSurface.astro';
import EmptyState from '../surface/EmptyState.astro';
import Panel from '../surface/Panel.astro';
import ResourceCard from '../surface/ResourceCard.astro';
import CapacityControlRoom from './CapacityControlRoom.astro';
import type { Tone } from '../types.ts';

type Row = Record<string, any>;
interface Props { teamId?: string; timeZone: string; fleet: any[]; providers: Row[]; providerAlerts: Row[]; providerRequests: Row[]; memberships: Row[]; reservations: Row[]; usageCount: number; ledgerCount: number; registrationKey: Row; canManage: boolean; csrfToken: string }
const { teamId, timeZone, fleet, providers, providerAlerts, providerRequests, memberships, reservations, usageCount, ledgerCount, registrationKey, canManage, csrfToken } = Astro.props as Props;
const text = (...values: unknown[]) => String(values.find((value) => typeof value === 'string' && value.trim()) ?? '');
const tone = (value: unknown): Tone => ['failed','blocked','rejected','revoked','disabled'].includes(String(value)) ? 'danger' : ['ready','active','approved','enabled'].includes(String(value)) ? 'success' : 'default';
const base = `/v1/teams/${encodeURIComponent(teamId ?? '')}/capacity`, registrationBase = `/v1/teams/${encodeURIComponent(teamId ?? '')}/capacity-registration-key`;
---
<section class="ts-template" aria-label="Capacity operations" data-scene="command.capacity">
	<PageHeader eyebrow="Command · Capacity" title="Capacity and routing" description="Understand supply, commitments, actual usage, and pressure without supervising provider internals."><Button slot="actions" href="/app/command" variant="secondary">Command overview</Button></PageHeader><ModeNavigation mode="command" current="capacity" />
	{!teamId ? <EmptyState title="Choose an active team" description="Capacity evidence is team-scoped." /> : <>
		<CapacityControlRoom providers={fleet} {timeZone} title="Provider energy grid" description="Strict intersections of provider supply, team grants, reservations, and live usage." />
		<MetricGrid min="12rem"><MetricCard label="Provider sessions" value={providers.length} description="Availability reports" /><MetricCard label="Reservations" value={reservations.length} description="Committed capacity" /><MetricCard label="Usage records" value={usageCount} description="Reported actuals" /><MetricCard label="Ledger entries" value={ledgerCount} description="Settled accounting evidence" /></MetricGrid>
		{providerAlerts.length ? <Panel eyebrow="Provider blockers" title={`${providerAlerts.length} capability offer alert${providerAlerts.length === 1 ? '' : 's'}`} description="Unavailable offers remain excluded from assignment matching until the provider updates and requalifies them.">{providerAlerts.map((alert) => <ResourceCard title={text(alert.code) || 'Provider offer unavailable'} description={text(alert.message) || `${alert.offerId ?? 'offer'} · ${alert.status ?? 'unavailable'}`} status={String(alert.status ?? 'blocked')} tone="danger" />)}</Panel> : null}
		<div class="ts-resource-grid"><Panel eyebrow="Connection authority" title="Provider invite circuit" description="Invite authority is team-scoped. Values remain concealed until an explicit audited reveal.">
			<ResourceCard title="Team invite token" description={text(registrationKey.status) || 'Not initialized'} status={String(registrationKey.status ?? 'unknown')} tone={tone(registrationKey.status)} />
			{canManage ? <div class="ts-button-row">{['rotate','enable','disable'].map((action) => <form method="post" action={`${registrationBase}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} the team capacity invite token?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`capacity-key:${action}:${registrationKey.generation ?? 'current'}`} /><Button type="submit" variant={action === 'disable' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}<p class="ts-help-text">Secret reveal is intentionally excluded from page hydration and logs. Use the audited reveal action after step-up authentication.</p>
		</Panel><Panel eyebrow="Intake" title={`${providerRequests.length} provider requests`} description="Approve identities only after reviewing the signed capability and supply offer.">{providerRequests.map((request) => <div class="ts-capacity-request"><ResourceCard title={text(request.displayName, request.providerId) || 'Provider request'} description={text(request.capabilitySummary, request.status)} status={String(request.status ?? 'pending')} tone={tone(request.status)} />{canManage && String(request.status) === 'pending' ? <div class="ts-button-row">{['approve','reject'].map((action) => <form method="post" action={`/v1/teams/${encodeURIComponent(teamId)}/capacity-provider-requests/${encodeURIComponent(String(request.id))}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} this capacity provider?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${request.id}:${action}:${request.updatedAt ?? 'current'}`} />{action === 'reject' ? <input class="ts-control" name="reason" aria-label="Rejection reason" required placeholder="Reason" /> : null}<Button type="submit" variant={action === 'reject' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}</div>)}{!providerRequests.length ? <p>No registration requests are waiting.</p> : null}</Panel></div>
		<Panel eyebrow="Fleet governance" title={`${memberships.length} approved provider memberships`} description="Teams control approval, grants, suspension, and revocation. Private host settings remain provider-owned."><div class="ts-capacity-memberships">{memberships.map((membership) => <article><div><strong>{text(membership.teamAlias, membership.displayName, membership.providerId)}</strong><code>{String(membership.id)}</code><span>{String(membership.status)}</span></div>{canManage ? <div class="ts-button-row">{(String(membership.status) === 'suspended' ? ['resume','revoke'] : ['suspend','revoke']).map((action) => <form method="post" action={`/v1/teams/${encodeURIComponent(teamId)}/capacity-provider-memberships/${encodeURIComponent(String(membership.id))}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} this provider membership?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${membership.id}:${action}:${membership.updatedAt ?? 'current'}`} /><Button type="submit" variant={action === 'revoke' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}</article>)}</div></Panel>
		<div class="ts-resource-grid"><SemanticCollectionSurface viewId="capacity" regionId="providers" presentation="capacity-control-room"><Panel eyebrow="Supply" title="Provider availability" description="Capacity providers report native budgets, concurrency, windows, and capabilities.">{providers.map((provider) => <ResourceCard title={text(provider.providerName, provider.providerId) || 'Capacity provider'} description={text(provider.capabilitySummary, provider.lifecycleReason) || 'Availability session'} status={String(provider.status ?? 'unknown')} tone={tone(provider.status)} />)}{!providers.length ? <p>No provider sessions were returned.</p> : null}</Panel></SemanticCollectionSurface><Panel eyebrow="Demand" title="Reservations and pressure" description="Open an assignment for routing evidence or review an overrun through its existing authorized action.">{reservations.map((reservation) => <div><ResourceCard title={text(reservation.projectName, reservation.projectId) || 'Capacity reservation'} description={text(reservation.reason, reservation.status) || 'Reserved capacity'} status={String(reservation.overrunStatus ?? reservation.status ?? 'reserved')} tone={tone(reservation.overrunStatus ?? reservation.status)} href={reservation.assignmentId ? `/app/command/assignments/${encodeURIComponent(String(reservation.assignmentId))}` : undefined} />{canManage && ['requested','pending'].includes(String(reservation.overrunStatus ?? reservation.overrun_status ?? '')) ? <div class="ts-button-row">{['approve','reject'].map((decision) => <form method="post" action={`${base}/reservations/${encodeURIComponent(String(reservation.id))}/overrun/${decision}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${decision === 'approve' ? 'Approve' : 'Reject'} this overrun request?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${reservation.id}:${decision}:${reservation.updatedAt ?? reservation.createdAt ?? 'current'}`} /><label class="ts-field"><span class="ts-field__label">Reason</span><input class="ts-control" name="reason" required /></label><Button type="submit" variant={decision === 'reject' ? 'danger' : 'secondary'}>{decision === 'approve' ? 'Approve overrun' : 'Reject overrun'}</Button></form>)}</div> : null}</div>)}{!reservations.length ? <p>No reservation evidence was returned.</p> : null}</Panel></div>
		<Panel eyebrow="Accounting" title="Usage and ledger" description="Actuals and settlement remain durable API control-plane records, not reconciled infrastructure."><p>{usageCount} usage records and {ledgerCount} ledger entries are visible in the current bounded snapshot.</p></Panel>
	</>}
</section>
<style>.ts-capacity-request{display:grid;gap:.6rem;padding-block:.65rem;border-bottom:1px solid var(--sl-color-gray-5)}.ts-help-text{color:var(--sl-color-gray-3);font-size:.78rem}.ts-capacity-memberships{display:grid;gap:.65rem}.ts-capacity-memberships article{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem;border:1px solid var(--sl-color-gray-5);background:color-mix(in srgb,var(--sl-color-black) 12%,transparent)}.ts-capacity-memberships article>div:first-child{display:grid;gap:.2rem}.ts-capacity-memberships code{font-size:.65rem;color:var(--sl-color-gray-3)}.ts-capacity-memberships span{font:700 .62rem var(--ts-font-mono,monospace);text-transform:uppercase;color:var(--sl-color-accent)}@media(max-width:42rem){.ts-capacity-memberships article{align-items:stretch;flex-direction:column}}</style>
