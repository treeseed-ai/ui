---
import Timestamp from '../data/Timestamp.astro';
import CapacityMeter from './CapacityMeter.astro';
interface Meter { label: string; used: number; reserved?: number; total: number; unit?: string; tone?: 'mint' | 'amber' | 'violet' | 'danger' }
interface Props { id: string; name: string; providerClass?: string; status: string; owner?: string; capabilities?: string[]; meters?: Meter[]; updatedAt?: string | null; timeZone?: string; assignments?: number }
const { id, name, providerClass = 'agent', status, owner = 'external', capabilities = [], meters = [], updatedAt, timeZone = 'UTC', assignments = 0 } = Astro.props as Props;
const online = ['active','available','ready','online'].includes(status.toLowerCase());
---
<article class:list={['ts-provider-battery', online && 'is-online']} data-provider-id={id} data-provider-class={providerClass}>
	<header><div class="ts-provider-battery__glyph" aria-hidden="true"><span></span><span></span><span></span></div><div><p>{providerClass.replace('-', ' ')}</p><h3>{name}</h3></div><span class="ts-provider-battery__state">{status}</span></header>
	<div class="ts-provider-battery__identity"><code>{id}</code><span>{owner}</span><span>{assignments} active</span></div>
	<div class="ts-provider-battery__meters">{meters.map((meter) => <CapacityMeter {...meter} />)}{!meters.length ? <p class="ts-provider-battery__empty">Awaiting dimensional supply telemetry.</p> : null}</div>
	<footer><div>{capabilities.slice(0, 5).map((capability) => <span>{capability.replaceAll('_',' ')}</span>)}</div>{updatedAt ? <small>signal <Timestamp value={updatedAt} timeZone={timeZone} style="time" /></small> : null}</footer>
</article>
<style>
	.ts-provider-battery{position:relative;display:grid;gap:1rem;padding:1rem;border:1px solid color-mix(in srgb,var(--sl-color-gray-4,#65717c) 35%,transparent);background:linear-gradient(150deg,rgba(18,25,31,.97),rgba(8,13,17,.97));box-shadow:0 10px 30px rgba(0,0,0,.25),inset 0 1px rgba(255,255,255,.04);clip-path:polygon(0 0,calc(100% - 13px) 0,100% 13px,100% 100%,0 100%)}.ts-provider-battery.is-online{border-color:rgba(102,239,196,.36)}header{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.8rem}header p{margin:0;color:#66efc4;font:700 .62rem/1 var(--ts-font-mono,monospace);letter-spacing:.12em;text-transform:uppercase}h3{margin:.22rem 0 0;font-size:1rem}.ts-provider-battery__glyph{display:flex;align-items:end;gap:2px;width:2rem;height:2.45rem;padding:.25rem;border:1px solid rgba(102,239,196,.45);border-radius:2px}.ts-provider-battery__glyph span{flex:1;background:#66efc4;height:38%;opacity:.35}.is-online .ts-provider-battery__glyph span:nth-child(2){height:64%;opacity:.7}.is-online .ts-provider-battery__glyph span:nth-child(3){height:90%;opacity:1;box-shadow:0 0 8px rgba(102,239,196,.7)}.ts-provider-battery__state{padding:.3rem .48rem;border:1px solid currentColor;color:#f5b94f;font:700 .62rem var(--ts-font-mono,monospace);text-transform:uppercase}.is-online .ts-provider-battery__state{color:#66efc4}.ts-provider-battery__identity{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:.6rem;color:var(--sl-color-gray-3,#8a959e);font:600 .63rem var(--ts-font-mono,monospace)}.ts-provider-battery__identity code{overflow:hidden;text-overflow:ellipsis}.ts-provider-battery__meters{display:grid;gap:.9rem;padding:.85rem;background:rgba(0,0,0,.2);border-block:1px solid rgba(255,255,255,.05)}.ts-provider-battery__empty{margin:0;color:var(--sl-color-gray-3,#8a959e);font-size:.78rem}footer{display:flex;justify-content:space-between;align-items:end;gap:.8rem}footer>div{display:flex;flex-wrap:wrap;gap:.3rem}footer span{padding:.2rem .36rem;background:rgba(170,135,255,.1);color:#c7b5ff;font:600 .58rem var(--ts-font-mono,monospace);text-transform:uppercase}footer small{white-space:nowrap;color:var(--sl-color-gray-3,#8a959e);font:600 .6rem var(--ts-font-mono,monospace)}@media(max-width:34rem){.ts-provider-battery__identity{grid-template-columns:1fr}.ts-provider-battery__identity span{display:inline}footer{align-items:start;flex-direction:column}}
</style>
