---
import ProviderBatteryCard from './ProviderBatteryCard.astro';
type Provider = Astro.ComponentProps<typeof ProviderBatteryCard>;
interface Props { providers: Provider[]; title?: string; description?: string; timeZone?: string }
const { providers, title = 'Capacity control room', description = 'Live supply, reservations, and provider pressure.', timeZone = 'UTC' } = Astro.props as Props;
const online = providers.filter((provider) => ['active','available','ready','online'].includes(provider.status.toLowerCase())).length;
---
<section class="ts-capacity-control-room" data-scene="capacity.control-room">
	<header class="ts-capacity-control-room__mast"><div><p>Agent Lab · Energy plane</p><h2>{title}</h2><span>{description}</span></div><div class="ts-capacity-control-room__signal"><strong>{online}/{providers.length}</strong><span>providers online</span></div></header>
	<div class="ts-capacity-control-room__bus" aria-hidden="true"><span></span><i></i><span></span><i></i><span></span></div>
	<div class="ts-capacity-control-room__fleet">{providers.map((provider) => <ProviderBatteryCard {...provider} timeZone={timeZone} />)}</div>
	{!providers.length ? <div class="ts-capacity-control-room__empty"><strong>No batteries connected</strong><span>Create an invite token or apply a provider seed to energize this team.</span></div> : null}
</section>
<style>
	.ts-capacity-control-room{--grid:rgba(102,239,196,.045);position:relative;isolation:isolate;display:grid;gap:1rem;padding:clamp(1rem,2vw,1.5rem);overflow:hidden;border:1px solid rgba(102,239,196,.22);background-color:#081014;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px),radial-gradient(circle at 88% 0,rgba(170,135,255,.13),transparent 34%);background-size:22px 22px,22px 22px,auto}.ts-capacity-control-room:before{content:"CAPACITY BUS / LIVE";position:absolute;right:-1.4rem;top:7rem;transform:rotate(90deg);color:rgba(102,239,196,.22);font:700 .55rem var(--ts-font-mono,monospace);letter-spacing:.18em}.ts-capacity-control-room__mast{display:flex;justify-content:space-between;align-items:end;gap:1rem}.ts-capacity-control-room__mast p{margin:0 0 .35rem;color:#66efc4;font:700 .65rem var(--ts-font-mono,monospace);letter-spacing:.14em;text-transform:uppercase}.ts-capacity-control-room__mast h2{margin:0;font-size:clamp(1.35rem,2.5vw,2rem);letter-spacing:-.035em}.ts-capacity-control-room__mast div>span{color:var(--sl-color-gray-3,#8b969f);font-size:.83rem}.ts-capacity-control-room__signal{text-align:right}.ts-capacity-control-room__signal strong{display:block;color:#66efc4;font:800 1.45rem var(--ts-font-mono,monospace)}.ts-capacity-control-room__signal span{text-transform:uppercase;letter-spacing:.08em;font:600 .58rem var(--ts-font-mono,monospace)}.ts-capacity-control-room__bus{display:grid;grid-template-columns:7px 1fr 7px 1fr 7px;align-items:center}.ts-capacity-control-room__bus span{width:7px;height:7px;border-radius:50%;background:#66efc4;box-shadow:0 0 9px #66efc4}.ts-capacity-control-room__bus i{height:1px;background:linear-gradient(90deg,#66efc4,rgba(102,239,196,.15))}.ts-capacity-control-room__fleet{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:1rem}.ts-capacity-control-room__empty{display:grid;gap:.25rem;place-items:center;padding:3rem 1rem;border:1px dashed rgba(102,239,196,.25);color:var(--sl-color-gray-3,#8b969f)}.ts-capacity-control-room__empty strong{color:#fff}@media(prefers-reduced-motion:no-preference){.is-online .ts-provider-battery__glyph span:last-child{animation:ts-energy-pulse 2.4s ease-in-out infinite}@keyframes ts-energy-pulse{50%{opacity:.55}}}@media(max-width:42rem){.ts-capacity-control-room__mast{align-items:start;flex-direction:column}.ts-capacity-control-room__signal{text-align:left}}
</style>
