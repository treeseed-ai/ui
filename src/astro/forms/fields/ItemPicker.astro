---
interface Props {
  name: string;
  label: string;
  value?: string;
  options: Array<{value: string; label: string; disabled?: boolean; iconProps?: Record<string, unknown>}>;
  Icon?: any;
}
const {name, label, value = '', options, Icon} = Astro.props as Props;
const id = `picker-${crypto.randomUUID()}`;
---
<fieldset class="ts-choice-picker">
  <legend>{label}</legend>
  <div class="ts-choice-picker__items">
    {options.map((item, index) => <div class="ts-choice-picker__option">
      <input type="radio" id={`${id}-${index}`} name={name} value={item.value} aria-label={item.label} checked={value === item.value} disabled={item.disabled} />
      <label for={`${id}-${index}`} title={item.label}>
        {Icon && item.iconProps ? <Icon {...item.iconProps} /> : <span>{item.label}</span>}
        <span class="ts-choice-picker__name">{item.label}</span>
      </label>
    </div>)}
  </div>
</fieldset>
