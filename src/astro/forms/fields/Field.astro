---
import HelpTrigger from '../../help/HelpTrigger.astro';

interface Props {
	label: string;
	id?: string;
	name?: string;
	help?: string;
	error?: string;
	required?: boolean;
	full?: boolean;
	class?: string;
	knowledgePageId?: string;
}

const {
	label,
	id,
	name,
	help,
	error,
	required = false,
	full = false,
	class: className,
	knowledgePageId,
} = Astro.props as Props;

const fieldId = id ?? name;
const helpId = fieldId && help ? `${fieldId}-help` : undefined;
const errorId = fieldId ? `${fieldId}-error` : undefined;
const slotProps = { helpId, errorId, describedBy: [helpId, errorId].filter(Boolean).join(' ') || undefined };
---

<div class:list={['ts-field', full && 'ts-field--full', className]} data-ts-field>
	<label class="ts-field__label" for={fieldId}>
		<span class="ts-field__label-text">
			<span>{label}</span>
			{required ? <span class="ts-field__required" aria-hidden="true">*</span> : null}
		</span>
		{knowledgePageId ? <HelpTrigger knowledgePageId={knowledgePageId} label={`Help with ${label}`} /> : null}
	</label>
	<div class="ts-field__control">
		<slot {...slotProps} />
	</div>
	{help ? <p class="ts-field__help" id={helpId}>{help}</p> : null}
	{errorId ? <p class="ts-field__error" id={errorId} data-ts-field-error hidden={!error}>{error}</p> : null}
</div>
