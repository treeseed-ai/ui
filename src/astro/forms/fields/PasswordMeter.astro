---
interface Props {
	inputId?: string;
	label?: string;
	minLength?: number;
	class?: string;
}

const {
	inputId,
	label = 'Password strength',
	minLength = 12,
	class: className,
} = Astro.props as Props;
---

<div
	class:list={['ts-password-meter', className]}
	data-ts-password-meter
	data-input-id={inputId}
	data-min-length={minLength}
>
	<div class="ts-password-meter__header">
		<span>{label}</span>
		<span class="ts-password-meter__status" data-ts-password-meter-status role="status" aria-live="polite">Not started</span>
	</div>
	<div class="ts-password-meter__track" aria-hidden="true">
		<span class="ts-password-meter__bar" data-ts-password-meter-bar></span>
	</div>
	<ul class="ts-password-meter__rules">
		<li data-ts-password-rule="length">Use at least {minLength} characters</li>
		<li data-ts-password-rule="lowercase">Include a lowercase letter</li>
		<li data-ts-password-rule="uppercase">Include an uppercase letter</li>
		<li data-ts-password-rule="number">Include a number</li>
		<li data-ts-password-rule="symbol">Include a symbol</li>
		<li data-ts-password-rule="spaces">Do not use spaces</li>
	</ul>
</div>

<script is:inline data-astro-rerun>
	(() => {
		const controllerKey = Symbol.for('ui.password-meter-controller');

		function scorePassword(value, minLength) {
			const checks = {
				length: value.length >= minLength,
				lowercase: /[a-z]/.test(value),
				uppercase: /[A-Z]/.test(value),
				number: /\d/.test(value),
				symbol: /[^A-Za-z0-9\s]/.test(value),
				spaces: value.length > 0 && !/\s/.test(value),
			};
			return { checks, score: Object.values(checks).filter(Boolean).length };
		}

		function resolveInput(meter) {
			const inputId = meter.dataset.inputId;
			return inputId
				? document.getElementById(inputId)
				: meter.closest('form')?.querySelector('[data-ts-password-input], input[type="password"]');
		}

		function updateMeter(meter) {
			if (!(meter instanceof HTMLElement)) return;
			const minLength = Number(meter.dataset.minLength || 12);
			const input = resolveInput(meter);
			if (!(input instanceof HTMLInputElement)) return;
			meter.dataset.tsPasswordMeterReady = 'true';

			const status = meter.querySelector('[data-ts-password-meter-status]');
			const bar = meter.querySelector('[data-ts-password-meter-bar]');
			const { checks, score } = scorePassword(input.value, minLength);
			meter.dataset.strength = String(score);
			if (status) status.textContent = !input.value
				? 'Not started'
				: score === 6
					? 'Strong'
					: score >= 4
						? 'Almost there'
						: score >= 2
							? 'Weak'
							: 'Too weak';
			if (bar instanceof HTMLElement) bar.style.setProperty('--ts-password-strength', String(score));
			for (const [rule, passed] of Object.entries(checks)) {
				const item = meter.querySelector(`[data-ts-password-rule="${rule}"]`);
				if (item instanceof HTMLElement) item.dataset.passed = passed ? 'true' : 'false';
			}
		}

		function updateForInput(input) {
			if (!(input instanceof HTMLInputElement)) return;
			for (const meter of document.querySelectorAll('[data-ts-password-meter]')) {
				if (resolveInput(meter) === input) updateMeter(meter);
			}
		}

		function initialize() {
			document.querySelectorAll('[data-ts-password-meter]').forEach(updateMeter);
		}

		const previousController = window[controllerKey];
		previousController?.destroy?.();

		const handlePasswordChange = (event) => updateForInput(event.target);
		document.addEventListener('input', handlePasswordChange);
		document.addEventListener('change', handlePasswordChange);
		document.addEventListener('astro:page-load', initialize);
		window[controllerKey] = {
			destroy() {
				document.removeEventListener('input', handlePasswordChange);
				document.removeEventListener('change', handlePasswordChange);
				document.removeEventListener('astro:page-load', initialize);
			},
		};
		initialize();
	})();
</script>
