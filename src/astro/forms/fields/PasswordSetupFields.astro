---
import Field from './Field.astro';
import PasswordMeter from './PasswordMeter.astro';
import TextInput from './TextInput.astro';

interface Props {
	passwordId: string;
	passwordLabel?: string;
	passwordName?: string;
	confirmId?: string;
	confirmLabel?: string;
	confirmName?: string;
	minLength?: number;
	class?: string;
}

const {
	passwordId,
	passwordLabel = 'Password',
	passwordName = 'password',
	confirmId = `${passwordId}Confirmation`,
	confirmLabel = 'Confirm password',
	confirmName = 'confirmPassword',
	minLength = 12,
	class: className,
} = Astro.props as Props;
const matchStatusId = `${confirmId}-match`;
---

<div class:list={['ts-password-setup', className]} data-ts-password-setup>
	<Field label={passwordLabel} name={passwordId} required>
		<TextInput
			id={passwordId}
			name={passwordName}
			type="password"
			autocomplete="new-password"
			minlength={minLength}
			required
			data-ts-password-input
		/>
	</Field>
	<Field label={confirmLabel} name={confirmId} required>
		<TextInput
			id={confirmId}
			name={confirmName}
			type="password"
			autocomplete="new-password"
			minlength={minLength}
			required
			data-ts-confirm-password-input
			ariaDescribedby={matchStatusId}
		/>
		<span id={matchStatusId} class="auth-field-help" data-ts-password-match-status role="status" aria-live="polite"></span>
	</Field>
	<PasswordMeter inputId={passwordId} minLength={minLength} />
</div>

<script is:inline data-astro-rerun>
	(() => {
		const controllerKey = Symbol.for('ui.password-setup-controller');

		function update(setup) {
			if (!(setup instanceof HTMLElement)) return;
			const password = setup.querySelector('[data-ts-password-input]');
			const confirm = setup.querySelector('[data-ts-confirm-password-input]');
			const status = setup.querySelector('[data-ts-password-match-status]');
			if (!(password instanceof HTMLInputElement) || !(confirm instanceof HTMLInputElement) || !status) return;
			const hasConfirmation = Boolean(confirm.value);
			const matches = hasConfirmation && password.value === confirm.value;
			confirm.setCustomValidity(hasConfirmation && !matches ? 'Passwords do not match.' : '');
			if (!hasConfirmation) {
				confirm.removeAttribute('data-match-state');
				confirm.removeAttribute('aria-invalid');
				status.textContent = '';
				status.removeAttribute('data-tone');
				return;
			}
			confirm.dataset.matchState = matches ? 'match' : 'mismatch';
			confirm.setAttribute('aria-invalid', matches ? 'false' : 'true');
			status.textContent = matches ? 'Passwords match.' : 'Passwords do not match.';
			status.setAttribute('data-tone', matches ? 'success' : 'danger');
		}

		function updateFromEvent(event) {
			const target = event.target;
			if (!(target instanceof HTMLInputElement)) return;
			const setup = target.closest('[data-ts-password-setup]');
			if (setup) update(setup);
		}

		function initialize() {
			document.querySelectorAll('[data-ts-password-setup]').forEach(update);
		}

		const previousController = window[controllerKey];
		previousController?.destroy?.();
		document.addEventListener('input', updateFromEvent);
		document.addEventListener('change', updateFromEvent);
		document.addEventListener('astro:page-load', initialize);
		window[controllerKey] = {
			destroy() {
				document.removeEventListener('input', updateFromEvent);
				document.removeEventListener('change', updateFromEvent);
				document.removeEventListener('astro:page-load', initialize);
			},
		};
		initialize();
	})();
</script>
