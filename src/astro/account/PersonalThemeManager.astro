---
import Panel from '../surface/Panel.astro';
import Field from '../forms/fields/Field.astro';
import TextInput from '../forms/fields/TextInput.astro';
import Select from '../forms/fields/Select.astro';
import Button from '../forms/actions/Button.astro';
import FormActions from '../forms/actions/FormActions.astro';
import AccessibleDialog from '../overlays/AccessibleDialog.astro';
import ThemePreviewSwatch from '../theme/ThemePreviewSwatch.astro';
import { guidedThemePaletteForScheme, loadColorSchemes } from '../../theme/index.ts';

interface PersonalThemeItem { id: string; schemeId: string; name: string; baseScheme: string; palette: { light: Record<'canvas' | 'surface' | 'text' | 'accent', string>; dark: Record<'canvas' | 'surface' | 'text' | 'accent', string> }; updatedAt: string; }
interface Props { themes: PersonalThemeItem[]; activeScheme: string; workspaceScheme?: string; csrfToken: string; }
const { themes, activeScheme, workspaceScheme, csrfToken } = Astro.props as Props;
const definitions = loadColorSchemes();
const schemes = definitions.map((scheme) => ({ value: scheme.id, label: scheme.name }));
const basePalettes = Object.fromEntries(definitions.map((scheme) => [scheme.id, guidedThemePaletteForScheme(scheme.id)]));
const defaults = basePalettes.fern;
---

<div class="account-stack" data-scene="account-appearance">
	<Panel eyebrow="Built in" title="TreeSeed themes" description="Use the theme selector in the application header to choose the active theme." knowledgePageId="account.appearance">
		<div class="account-theme-table-wrap">
			<table class="account-theme-table" data-built-in-theme-table>
				<thead><tr><th scope="col">Preview</th><th scope="col">Theme</th><th scope="col">Status</th></tr></thead>
				<tbody>{definitions.map((scheme) => (
					<tr data-built-in-theme={scheme.id}>
						<td><ThemePreviewSwatch swatches={scheme.swatches} label={`${scheme.name} preview`} /></td>
						<th scope="row">{scheme.name}</th>
						<td><span class="account-theme-status" data-active={activeScheme === scheme.id ? 'true' : undefined}>{activeScheme === scheme.id ? 'Active' : 'Available'}</span></td>
					</tr>
				))}</tbody>
			</table>
		</div>
	</Panel>
	<Panel eyebrow="Personal" title="Your themes" description="Create reusable color systems. Creating or editing a theme never activates it." knowledgePageId="account.appearance">
		<div class="account-panel-stack">
			<Button type="button" data-dialog-open="create-personal-theme">Create theme</Button>
			<div class="account-list">{themes.length ? themes.map((theme) => (
			<details class="account-disclosure" data-active-personal-theme-name={activeScheme === theme.schemeId ? theme.name : undefined}>
				<summary><ThemePreviewSwatch swatches={[theme.palette.light.accent, theme.palette.light.surface, theme.palette.dark.accent, theme.palette.dark.canvas]} label={`${theme.name} preview`} /> <strong>{theme.name}</strong>{activeScheme === theme.schemeId ? ' · application' : workspaceScheme === theme.schemeId ? ' · content overlay' : ''}</summary>
				<form method="post" class="account-form" data-ts-submit="enhanced" data-ts-refresh-target="[data-scene='account-appearance']">
					<input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="themeId" value={theme.id} /><input type="hidden" name="intent" value="update-theme" /><input type="hidden" name="expectedUpdatedAt" value={theme.updatedAt} />
					<div class="account-field-row">
						<Field label="Theme name" name={`name-${theme.id}`}><TextInput id={`name-${theme.id}`} name="name" value={theme.name} required /></Field>
						<Field label="Base theme" name={`base-${theme.id}`}><Select id={`base-${theme.id}`} name="baseScheme" options={schemes} value={theme.baseScheme} /></Field>
					</div>
					{(['light', 'dark'] as const).map((mode) => <fieldset class="account-palette-group"><legend>{mode} palette</legend><div class="account-color-grid">{(['canvas', 'surface', 'text', 'accent'] as const).map((key) => <Field label={key} name={`${mode}.${key}`}><input id={`${theme.id}-${mode}-${key}`} class="ts-control" type="color" name={`${mode}.${key}`} value={theme.palette[mode][key]} /></Field>)}</div></fieldset>)}
					<FormActions class="account-form-actions"><Button type="submit">Save theme</Button><Button type="submit" name="intent" value="delete-theme" variant="danger" disabled={activeScheme === theme.schemeId || workspaceScheme === theme.schemeId}>Delete theme</Button></FormActions>
				</form>
			</details>
			)) : <p>No personal themes yet.</p>}</div>
		</div>
	</Panel>
	<AccessibleDialog id="create-personal-theme" title="Create a personal theme" description="Choose a base and eight key colors. TreeSeed derives the complete accessible token set.">
		<form method="post" class="account-form" data-ts-submit="enhanced" data-ts-refresh-target="[data-scene='account-appearance']" data-personal-theme-builder data-theme-palette-map={JSON.stringify(basePalettes)} data-theme-palette-source="fern">
			<input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="intent" value="create-theme" />
			<div class="account-field-row">
				<Field label="Theme name" id="theme-name"><TextInput id="theme-name" name="name" required /></Field>
				<Field label="Base theme" id="theme-base"><Select id="theme-base" name="baseScheme" options={schemes} value="fern" data-personal-theme-base /></Field>
			</div>
			{(['light', 'dark'] as const).map((mode) => <fieldset class="account-palette-group"><legend>{mode} palette</legend><div class="account-color-grid">{(['canvas', 'surface', 'text', 'accent'] as const).map((key) => <Field label={key} id={`create-${mode}-${key}`}><input id={`create-${mode}-${key}`} class="ts-control" type="color" name={`${mode}.${key}`} value={defaults[mode][key]} data-theme-color-mode={mode} data-theme-color-key={key} data-theme-color-value={defaults[mode][key]} /></Field>)}</div></fieldset>)}
			<FormActions class="account-form-actions"><Button type="submit" data-testid="create-personal-theme-submit">Create theme</Button><Button type="button" variant="secondary" data-dialog-close>Cancel</Button></FormActions>
		</form>
	</AccessibleDialog>
</div>

<script>
	document.addEventListener('change', (event) => {
		const select = event.target;
		if (!(select instanceof HTMLSelectElement) || !select.matches('[data-personal-theme-base]')) return;
		const form = select.closest<HTMLFormElement>('[data-personal-theme-builder]');
		if (!form) return;
		const palettes = JSON.parse(form.dataset.themePaletteMap ?? '{}');
		const palette = palettes[select.value];
		if (!palette) return;
		form.querySelectorAll<HTMLInputElement>('[data-theme-color-mode][data-theme-color-key]').forEach((input) => {
			const mode = input.dataset.themeColorMode;
			const key = input.dataset.themeColorKey;
			const value = mode && key ? palette[mode]?.[key] : null;
			if (typeof value !== 'string') return;
			input.value = value;
			input.dataset.themeColorValue = value;
		});
		form.dataset.themePaletteSource = select.value;
	});
</script>
