---
import Panel from '../surface/Panel.astro';
import Field from '../forms/fields/Field.astro';
import TextInput from '../forms/fields/TextInput.astro';
import Textarea from '../forms/fields/Textarea.astro';
import Button from '../forms/actions/Button.astro';
import FormActions from '../forms/actions/FormActions.astro';
interface AccountIdentity {
	id: string;
	username: string;
	firstName?: string | null;
	lastName?: string | null;
	image?: string | null;
	headline?: string | null;
	profileSummary?: string | null;
	location?: string | null;
	website?: string | null;
	expertise?: string[];
	emails: Array<{ id: string; email: string; status: string; isPrimary: boolean }>;
	updatedAt?: string;
}

interface Props {
	identity: AccountIdentity;
	identityManagementUrl: string;
	csrfToken: string;
}
const { identity, identityManagementUrl, csrfToken } = Astro.props as Props;
const management = new URL(identityManagementUrl);
if (management.protocol !== 'https:' || management.username || management.password || management.hash) throw new Error('Verified identity management URL required.');

---

<div class="account-stack" data-scene="account-identity">
	<Panel eyebrow="Identity" title="Public profile" description="Your permanent handle and public identity." knowledgePageId="account.identity">
		<form method="post" class="account-form" data-ts-submit="enhanced" data-ts-refresh-target="[data-scene='account-identity']">
			<input type="hidden" name="csrfToken" value={csrfToken} />
			<input type="hidden" name="intent" value="profile" />
			{identity.updatedAt ? <input type="hidden" name="expectedUpdatedAt" value={identity.updatedAt} /> : null}
			<div class="account-field-row" data-account-field-group="name">
				<Field label="First name" name="firstName"><TextInput id="firstName" name="firstName" value={identity.firstName ?? ''} autocomplete="given-name" /></Field>
				<Field label="Last name" name="lastName"><TextInput id="lastName" name="lastName" value={identity.lastName ?? ''} autocomplete="family-name" /></Field>
			</div>
			<div class="account-field-row" data-account-field-group="public-profile">
				<Field label="Username" help="Your username is public and cannot be changed.">
					<TextInput name="username" value={identity.username} disabled />
				</Field>
				<Field label="Profile image URL" name="image" help="Use an HTTPS image URL."><TextInput id="image" name="image" type="url" value={identity.image ?? ''} /></Field>
			</div>
			<div class="account-field-row" data-account-field-group="profile-context">
				<Field label="Knowledge headline" name="headline" help="A concise description of the knowledge you create.">
					<TextInput id="headline" name="headline" value={identity.headline ?? ''} maxlength={120} placeholder="Researcher, builder, and systems thinker" />
				</Field>
				<Field label="Location" name="location">
					<TextInput id="location" name="location" value={identity.location ?? ''} maxlength={100} autocomplete="address-level2" />
				</Field>
			</div>
			<div class="account-field-row" data-account-field-group="profile-links">
				<Field label="Website" name="website" help="Use a secure HTTPS address.">
					<TextInput id="website" name="website" type="url" value={identity.website ?? ''} placeholder="https://example.com" />
				</Field>
				<Field label="Areas of knowledge" name="expertise" help="Separate up to eight topics with commas.">
					<TextInput id="expertise" name="expertise" value={(identity.expertise ?? []).join(', ')} placeholder="Knowledge systems, research, governance" />
				</Field>
			</div>
			<Field label="Profile summary" name="profileSummary" help="Describe what you study, build, teach, or hope to share.">
				<Textarea id="profileSummary" name="profileSummary" value={identity.profileSummary ?? ''} maxlength={600} rows={5} />
			</Field>
			<FormActions class="account-form-actions"><Button type="submit">Save identity</Button></FormActions>
		</form>
	</Panel>

	<Panel eyebrow="Email" title="Contact email addresses" description="Addresses used for this application’s notifications. Sign-in security is managed separately." knowledgePageId="account.emails">
		<div class="account-list">
			{identity.emails.map((email) => (
				<form
					method="post"
					class="account-email-row"
					data-account-email={email.email}
					data-account-email-status={email.status}
					data-ts-submit="enhanced"
					data-ts-refresh-target="[data-scene='account-identity']"
				>
					<input type="hidden" name="csrfToken" value={csrfToken} />
					<input type="hidden" name="emailId" value={email.id} />
					{identity.updatedAt ? <input type="hidden" name="expectedUpdatedAt" value={identity.updatedAt} /> : null}
					<div class="account-list-heading">
						<strong>{email.email}</strong>
						<span>{email.status}{email.isPrimary ? ' · primary' : ''}</span>
					</div>
					<div class="account-list-actions">
						{email.status !== 'verified' ? <Button class="account-email-action" type="submit" name="intent" value="resend-email" variant="secondary" size="sm">Resend verification</Button> : null}
						{email.status === 'verified' && !email.isPrimary ? <Button class="account-email-action" type="submit" name="intent" value="primary-email" variant="secondary" size="sm">Make primary</Button> : null}
						{!email.isPrimary ? <Button class="account-email-action" type="submit" name="intent" value="delete-email" variant="danger" size="sm">Remove</Button> : null}
					</div>
				</form>
			))}
			<form method="post" class="account-email-add-form" data-ts-submit="enhanced" data-ts-refresh-target="[data-scene='account-identity']">
				<input type="hidden" name="csrfToken" value={csrfToken} />
				<input type="hidden" name="intent" value="add-email" />
				<Field label="Add email" name="email"><TextInput id="email" name="email" type="email" autocomplete="email" required /></Field>
				<Button type="submit">Add and verify</Button>
			</form>
		</div>
	</Panel>

	<Panel eyebrow="Sign-in security" title="Manage your identity" description="Your identity provider manages passwords, multi-factor authentication, recovery and connected sign-in accounts." knowledgePageId="identity.account-security">
		<a class="ts-button ts-button--secondary" href={management.href} data-astro-reload>Manage sign-in and security</a>
	</Panel>
</div>
