---
import Panel from '../surface/Panel.astro';
import Button from '../forms/actions/Button.astro';
import FormActions from '../forms/actions/FormActions.astro';

interface NotificationPreferencesModel { emailCadence: 'immediate' | 'daily' | 'weekly'; globalContentTypes: string[]; projectOverrides: Array<{ projectId: string; contentTypes: string[] }>; }
interface ContentCapability { id: string; label: string; description: string; }
interface ProjectOption { id: string; name?: string | null; slug: string; }
interface Props { preferences: NotificationPreferencesModel; capabilities: ContentCapability[]; projects: ProjectOption[]; csrfToken: string; }
const { preferences, capabilities, projects, csrfToken } = Astro.props as Props;
const overrides = new Map<string, string[]>(preferences.projectOverrides.map((entry) => [entry.projectId, entry.contentTypes]));
---

<form method="post" class="account-stack" data-scene="account-notifications" data-ts-submit="enhanced" data-ts-refresh-target="[data-scene='account-notifications']">
	<input type="hidden" name="csrfToken" value={csrfToken} />
	<Panel eyebrow="Delivery" title="Email cadence" description="In-app notifications remain immediate.">
		<div class="account-notification-cadence" role="radiogroup" aria-label="Email cadence">
			{['immediate', 'daily', 'weekly'].map((cadence) => (
				<label class="account-notification-choice">
					<input type="radio" name="emailCadence" value={cadence} checked={preferences.emailCadence === cadence} />
					<span>{cadence === 'immediate' ? 'As posted' : cadence[0].toUpperCase() + cadence.slice(1)}</span>
				</label>
			))}
		</div>
	</Panel>
	<Panel eyebrow="All projects" title="Content types" description="These choices apply to every project you can access unless a project override replaces them.">
		<div class="account-notification-choice-list" role="group" aria-label="All-project content types" data-notification-content-choices data-orientation="vertical">
			{capabilities.map((capability) => (
				<label class="account-notification-choice">
					<input type="checkbox" name="globalContentTypes" value={capability.id} checked={preferences.globalContentTypes.includes(capability.id)} />
					<span class="account-notification-choice__content">
						<strong>{capability.label}</strong>
						<small>{capability.description}</small>
					</span>
				</label>
			))}
		</div>
	</Panel>
	<Panel eyebrow="Optional" title="Project overrides" description="Select a project to replace the all-project choices for that project.">
		<div class="account-list">{projects.map((project) => {
			const selected = overrides.has(project.id);
			const types = overrides.get(project.id) ?? [];
			const projectLabel = project.name ?? project.slug;
			return (
				<details class="account-disclosure account-notification-project" open={selected} data-notification-project-override data-notification-project-name={projectLabel}>
					<summary>
						<label class="account-notification-choice">
							<input type="checkbox" name="overrideProjects" value={project.id} checked={selected} aria-expanded={selected ? 'true' : 'false'} data-notification-project-toggle />
							<span>{projectLabel}</span>
						</label>
					</summary>
					<div class="account-notification-choice-list" role="group" aria-label={`${projectLabel} content types`} data-notification-content-choices data-orientation="vertical">
						{capabilities.map((capability) => (
							<label class="account-notification-choice">
								<input type="checkbox" name={`projectTypes:${project.id}`} value={capability.id} checked={types.includes(capability.id)} />
								<span class="account-notification-choice__content">
									<strong>{capability.label}</strong>
									<small>{capability.description}</small>
								</span>
							</label>
						))}
					</div>
				</details>
			);
		})}</div>
	</Panel>
	<FormActions class="account-form-actions"><Button type="submit">Save notification preferences</Button></FormActions>
</form>

<script>
	const projectToggleSelector = '[data-notification-project-toggle]';

	function syncProjectOverride(toggle: HTMLInputElement) {
		const disclosure = toggle.closest<HTMLDetailsElement>('[data-notification-project-override]');
		if (!disclosure) return;
		disclosure.open = toggle.checked;
		toggle.setAttribute('aria-expanded', String(toggle.checked));
	}

	function syncProjectOverrides() {
		document.querySelectorAll<HTMLInputElement>(projectToggleSelector).forEach(syncProjectOverride);
	}

	document.addEventListener('change', (event) => {
		const target = event.target;
		if (target instanceof HTMLInputElement && target.matches(projectToggleSelector)) syncProjectOverride(target);
	});
	document.addEventListener('astro:page-load', syncProjectOverrides);
	document.addEventListener('treeseed:content-updated', syncProjectOverrides);
	syncProjectOverrides();
</script>
