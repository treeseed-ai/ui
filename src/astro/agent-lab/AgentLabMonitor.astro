---
import { OperationsMonitorHeader } from '../../react/operations-monitor/index.ts';

interface Props {
	frame: any;
	csrfToken: string;
	metricDestinations: Record<string, string>;
	logoSrc?: string;
}

const { frame, csrfToken, metricDestinations, logoSrc = '/logo.svg' } = Astro.props as Props;
const selection = new URLSearchParams();
if (frame.overview.workdayContext.selectedDate) selection.set('date', frame.overview.workdayContext.selectedDate);
if (frame.overview.workdayContext.selectedWorkdayId) selection.set('workday', frame.overview.workdayContext.selectedWorkdayId);
const withSelection = (href: string) => `${href}${href.includes('?') ? '&' : '?'}${selection}`;
const destinations = Object.fromEntries(Object.entries(metricDestinations).map(([key, href]) => [key, withSelection(href)]));
---
<OperationsMonitorHeader client:load initialOverview={frame.overview} initialActivity={frame.activity} initialSeries={frame.series}
	initialAllocation={frame.allocation} endpoints={frame.endpoints} preference={frame.preference}
	metricDestinations={destinations} {csrfToken} {logoSrc} />
