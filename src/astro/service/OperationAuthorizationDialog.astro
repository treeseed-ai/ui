---
import Button from '../forms/actions/Button.astro';
import HelpTrigger from '../help/HelpTrigger.astro';

interface Props {
	title?: string;
	operation: string;
	destination: string;
	duration?: string;
	requiredFields: string[];
	submitLabel?: string;
	knowledgePageId?: string;
}

const {
	title = 'Authorize secure operation',
	operation,
	destination,
	duration = 'Up to five minutes',
	requiredFields,
	submitLabel = 'Authorize and continue',
	knowledgePageId,
} = Astro.props;
---

<details class="ts-operation-authorization">
	<summary><span>{title}</span>{knowledgePageId ? <HelpTrigger knowledgePageId={knowledgePageId} label={`Help with ${title}`} /> : null}</summary>
	<div class="ts-operation-authorization__body">
		<p>{operation}</p>
		<dl class="ts-key-value-list">
			<div><dt>Destination</dt><dd>{destination}</dd></div>
			<div><dt>Lease duration</dt><dd>{duration}</dd></div>
			<div><dt>Credential fields</dt><dd>{requiredFields.join(', ')}</dd></div>
		</dl>
		<p class="ts-help-text">Only these fields are decrypted in this browser, sealed to the operations runner, used from memory, and discarded. The lease can be consumed once.</p>
		<slot />
		<div class="ts-action-bar">
			<Button type="submit">{submitLabel}</Button>
		</div>
	</div>
</details>
