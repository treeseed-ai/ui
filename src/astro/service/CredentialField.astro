---
import Badge from '../data/Badge.astro';
import Field from '../forms/fields/Field.astro';
import TextInput from '../forms/fields/TextInput.astro';

interface Props {
	name: string;
	label: string;
	description: string;
	sensitive?: boolean;
	required?: boolean;
	value?: string;
	placeholder?: string;
	disabled?: boolean;
}

const {
	name,
	label,
	description,
	sensitive = false,
	required = false,
	value,
	placeholder,
	disabled = false,
} = Astro.props as Props;
---

<Field label={label} name={name} help={description} required={required} class="ts-credential-field">
	<div class="ts-credential-field__control">
		<TextInput
			name={name}
			type={sensitive ? 'password' : 'text'}
			value={value}
			placeholder={placeholder}
			required={required}
			disabled={disabled}
			autocomplete={sensitive ? 'off' : undefined}
			ariaDescribedby={`${name}-help ${name}-error`}
		/>
		<Badge tone={sensitive ? 'warning' : 'muted'} size="sm">{sensitive ? 'Encrypted locally' : 'Account metadata'}</Badge>
	</div>
</Field>
