---
import Badge from '../../data/Badge.astro';
import Timestamp from '../../data/Timestamp.astro';
import Button from '../../forms/actions/Button.astro';
import SemanticCollectionSurface from '../../semantic/SemanticCollectionSurface.astro';
import EmptyState from '../../surface/EmptyState.astro';
import Panel from '../../surface/Panel.astro';
import SettingsTemplate from '../../templates/SettingsTemplate.astro';
import ProviderCard from '../ProviderCard.astro';
import SecretCustodyBadge from '../SecretCustodyBadge.astro';

interface CapabilityDefinition { type: string; label: string; }
interface ProviderDefinition { id: string; label: string; capabilities: readonly CapabilityDefinition[]; }
interface ServiceCapability { capabilityType: string; status: string; }
interface CredentialProfile { custodyMode: string; }
interface ServiceItem { id: string; providerId: string; displayName: string; status: string; capabilities?: ServiceCapability[]; credentialProfiles?: CredentialProfile[]; lastValidatedAt?: string | null; }
interface SectionItem { id: string; label: string; href: string; active?: boolean; }
interface VaultSummary { activeKeyVersion?: string | number; }
interface Props {
	teamName?: string;
	services?: ServiceItem[];
	providerCatalog: readonly ProviderDefinition[];
	sections: SectionItem[];
	providerFilter?: string;
	capabilityFilter?: string;
	vault?: VaultSummary | null;
	unavailable?: boolean;
	vaultUnavailable?: boolean;
	canManage?: boolean;
	timeZone?: string;
}
const { teamName, services = [], providerCatalog, sections, providerFilter = '', capabilityFilter = '', vault, unavailable = false, vaultUnavailable = false, canManage = false, timeZone = 'UTC' } = Astro.props as Props;
const filtered = services.filter((service) => (!providerFilter || service.providerId === providerFilter)
	&& (!capabilityFilter || service.capabilities?.some((item) => item.capabilityType === capabilityFilter)));
const capabilityOptions = [...new Map(providerCatalog.flatMap((item) => item.capabilities).map((item) => [item.type, item])).values()];
const provider = (id: string) => providerCatalog.find((item) => item.id === id);
---

<SettingsTemplate title="Services" description={teamName ? `Connect and manage provider accounts for ${teamName}.` : 'Select an active team to manage its provider services.'} {sections} knowledgePageId="services.connections" actions={teamName && canManage ? [{ id: 'services.connection.create', label: 'Add connection', href: '/app/services/new', state: 'allowed', auditSensitivity: 'normal' }] : []} class="ts-service-workspace">
	<section class="ts-stack" data-scene="service.collection" data-secret-custody="client-encrypted-vault">
	{!teamName ? <EmptyState title="Select an active team" description="Service connections are isolated by team. Choose a team from the sidebar first." actions={[{ label: 'Manage teams', href: '/app/teams' }]} />
	: unavailable ? <EmptyState title="Services are temporarily unavailable" description="The service API did not respond. No empty state has been inferred."><div slot="actions"><Button href="/app/services" variant="secondary" reload>Retry</Button></div></EmptyState>
	: <>
		{canManage ? <Panel eyebrow="Credential custody" title={vaultUnavailable ? 'Vault status unavailable' : vault ? 'Team vault ready' : 'Team vault setup required'} description={vaultUnavailable ? 'Service connections remain available, but credential custody status could not be loaded.' : vault ? 'Provider credentials are encrypted for explicitly granted administrators.' : 'Initialize personal and team vault access before saving provider credentials.'}>
			<div class="ts-action-bar"><Badge tone={vaultUnavailable ? 'danger' : vault ? 'success' : 'warning'} size="sm">{vaultUnavailable ? 'Retry required' : vault ? `Key version ${vault.activeKeyVersion}` : 'Not initialized'}</Badge><Button href="/app/services/vault" variant="secondary" size="sm">{vault ? 'Manage access' : 'Set up vault'}</Button></div>
		</Panel> : null}
		<form class="ts-template__filters" method="get" aria-label="Filter services">
			<label class="ts-field"><span class="ts-field__label">Provider</span><select class="ts-control" name="provider"><option value="">All providers</option>{providerCatalog.map((item) => <option value={item.id} selected={providerFilter === item.id}>{item.label}</option>)}</select></label>
			<label class="ts-field"><span class="ts-field__label">Capability</span><select class="ts-control" name="capability"><option value="">All capabilities</option>{capabilityOptions.map((item) => <option value={item.type} selected={capabilityFilter === item.type}>{item.label}</option>)}</select></label>
			<div class="ts-template__filter-actions"><Button type="submit" variant="secondary" size="sm">Apply</Button><Button href="/app/services" variant="ghost" size="sm">Reset</Button></div>
		</form>
		<SemanticCollectionSurface viewId="services" regionId="services" presentation="provider-connection-cards">
		{filtered.length ? <div class="ts-resource-grid" data-spacing="roomy">{filtered.map((service) => <ProviderCard provider={service.providerId} label={service.displayName} description={provider(service.providerId)?.label ?? service.providerId} href={`/app/services/${encodeURIComponent(service.id)}`} status={service.status} statusTone={service.status === 'active' ? 'success' : service.status === 'degraded' ? 'warning' : 'muted'}>
			<div class="ts-badge-list">{service.capabilities?.map((item) => <Badge tone={item.status === 'configured' ? 'info' : 'muted'} size="sm">{item.capabilityType.replaceAll('-', ' ')}</Badge>)}</div>
			<div class="ts-badge-list">{service.credentialProfiles?.map((item) => <SecretCustodyBadge mode={item.custodyMode} />)}</div>
			<p>{service.lastValidatedAt ? <>Last validated <Timestamp value={service.lastValidatedAt} {timeZone} /></> : 'Not yet validated'}</p>
		</ProviderCard>)}</div>
		: <EmptyState title={services.length ? 'No services match these filters' : 'No services connected'} description={services.length ? 'Change or reset the provider and capability filters.' : 'Connect GitHub, Cloudflare, Railway, or an external vault for this team.'} actions={[]} />}
		</SemanticCollectionSurface>
	</>}
	</section>
</SettingsTemplate>
