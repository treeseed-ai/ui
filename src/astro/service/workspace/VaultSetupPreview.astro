---
import Panel from '../../surface/Panel.astro';
import SettingsTemplate from '../../templates/SettingsTemplate.astro';
import StepNavigation from '../../navigation/StepNavigation.astro';
import Button from '../../forms/actions/Button.astro';
import Field from '../../forms/fields/Field.astro';
import TextInput from '../../forms/fields/TextInput.astro';
import HelpTrigger from '../../help/HelpTrigger.astro';
interface Props { sections: any[]; teamName: string; canManage: boolean }
const {sections,teamName,canManage} = Astro.props;
---
<SettingsTemplate title="Vault" description="Secure storage for your team's service credentials." {sections} knowledgePageId="services.vaults" class="ts-service-workspace">
  <div class="ts-vault-workspace" data-vault-workspace>
    <section class="ts-vault-default" aria-label="Default credential storage">
      <div><h2>TreeSeed-managed vault <span class="ts-vault-badge">Default</span></h2>
      <p>Provided for {teamName}. No setup required. You can replace managed storage with one custom vault for your team.</p></div>
      <HelpTrigger knowledgePageId="services.vaults.trust" label="How managed storage protects credentials" />
    </section>
    <Panel title="How your credentials are protected" class="ts-vault-protection" knowledgePageId="services.vaults.trust">
      <p>Service credentials are kept in the vault, not in project configuration. Authorized operations receive the access they need; sharing a connection does not give another team access to your secrets.</p>
      <p>With your own vault, you control storage and access policy. TreeSeed's authorized control plane and runners still need permission to retrieve credentials for the operations you enable.</p>
    </Panel>
    {canManage ? <>
      <Button variant="secondary" data-vault-open>Connect your own vault</Button>
      <div data-vault-preview class="ts-vault-setup ts-service-wizard" hidden>
        <StepNavigation steps={['Choose vault','Connection details','Review access']} label="Vault setup progress" />
        <div class="ts-service-wizard__body">
          <section data-vault-step="0" class="ts-form-stack"><Panel title="Connect an existing vault"><div class="ts-form-stack">
            <p>Use an OpenBao or HashiCorp Vault that your organization already manages.</p>
            <Field label="Vault provider" name="vaultBackend"><select class="ts-control" name="vaultBackend" data-vault-backend><option value="openbao">OpenBao</option><option value="hashicorp">HashiCorp Vault</option></select></Field>
            <HelpTrigger knowledgePageId="services.vaults.external" label="Help connecting your vault" />
          </div></Panel></section>
          <section data-vault-step="1" class="ts-form-stack" hidden><Panel title="Connection details"><div class="ts-form-stack">
            <Field label="Vault address" name="vaultEndpoint" help="HTTPS address only. Do not include a token or password." required><TextInput name="vaultEndpoint" type="url" placeholder="https://vault.example.com" required /></Field>
            <Field label="Secrets mount" name="vaultMount" help="The KV v2 secrets engine configured by your vault administrator." required><TextInput name="vaultMount" placeholder="secret" required /></Field>
          </div></Panel></section>
          <section data-vault-step="2" class="ts-form-stack" hidden><Panel title="Review access"><div class="ts-form-stack">
            <dl class="ts-vault-summary"><dt>Provider</dt><dd data-vault-backend-summary></dd><dt>Applies to</dt><dd>All of your team's service connections</dd></dl>
            <p>Your custom vault will replace managed storage after verification and a safe transition of existing credentials. There is no per-connection vault selection. If verification fails, your current vault stays in use.</p>
            <p>Verification checks TLS trust, network reachability, and scoped AppRole access. Do not provide a root token.</p>
            <HelpTrigger knowledgePageId="services.vaults.trust" label="About vault authentication and trust" />
            <p>Connection verification is currently unavailable.</p>
            <Button disabled>Verify and connect</Button>
          </div></Panel></section>
          <p data-wizard-status aria-live="polite" class="ts-vault-announcement"></p><p data-wizard-error role="alert" hidden></p>
        </div>
        <footer class="ts-service-wizard__actions"><Button variant="secondary" data-wizard-back hidden>Back</Button><Button data-wizard-next>Continue</Button></footer>
      </div>
    </> : <p>A team owner or service administrator can connect an external vault.</p>}
  </div>
</SettingsTemplate>
<script>
  import {mountWizard} from '../../../lib/forms/wizard/controller';
  function initialize() {
    document.querySelectorAll<HTMLElement>('[data-vault-workspace]').forEach(workspace => {
      if(workspace.dataset.initialized) return; workspace.dataset.initialized='true';
      const root=workspace.querySelector<HTMLElement>('[data-vault-preview]'); if(!root) return;
      const backend=root.querySelector<HTMLSelectElement>('[data-vault-backend]')!;
      const update=() => {
        root.querySelector('[data-vault-backend-summary]')!.textContent=backend.selectedOptions[0].textContent;
      };
      root.addEventListener('input',update); backend.addEventListener('change',update); update();
      const wizard=mountWizard(root,['provider','details','review'].map((id,index) => ({id,label:['Choose vault','Connection details','Review access'][index],
        panel:root.querySelector<HTMLElement>('[data-vault-step="'+index+'"]')!,validate:() => {
          if(index!==1) return;
          try { const url=new URL(root.querySelector<HTMLInputElement>('[name="vaultEndpoint"]')!.value);
            if(url.protocol!=='https:' || url.username || url.password || url.search || url.hash || url.pathname!=='/') return {fieldErrors:{vaultEndpoint:'Use an HTTPS origin without credentials, paths, or query parameters.'}};
          } catch { return {fieldErrors:{vaultEndpoint:'Enter a valid HTTPS vault address.'}}; }
        }})));
      workspace.querySelector<HTMLButtonElement>('[data-vault-open]')!.addEventListener('click',event => {
        root.hidden=false; (event.currentTarget as HTMLElement).hidden=true; void wizard.go(0);
      });
    });
  }
  initialize(); document.addEventListener('astro:page-load',initialize);
</script>
