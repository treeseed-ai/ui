---
import Button from '../../forms/actions/Button.astro';
import Field from '../../forms/fields/Field.astro';
import TextInput from '../../forms/fields/TextInput.astro';
import EmptyState from '../../surface/EmptyState.astro';
import Panel from '../../surface/Panel.astro';
import SettingsTemplate from '../../templates/SettingsTemplate.astro';
import CapabilitySelector from '../CapabilitySelector.astro';
import PermissionChecklist from '../PermissionChecklist.astro';
import ProviderCard from '../ProviderCard.astro';
interface Props { team?: any; canManage: boolean; provider?: any; providers: any[]; permissions: string[]; csrfToken: string; sections: any[] }
const { team, canManage, provider, providers, permissions, csrfToken, sections } = Astro.props as Props;
---
<SettingsTemplate title="Connect a provider" description="Choose the provider account first, then enable only the capabilities this team needs." {sections} knowledgePageId="services.connect" class="ts-service-workspace">
	<section class="ts-stack" data-scene="service.create">
	{!team ? <EmptyState title="Select an active team" description="A provider connection must belong to one team." actions={[{ label: 'Manage teams', href: '/app/teams' }]} />
	: !canManage ? <EmptyState title="Service administration required" description="Your role can view service availability but cannot connect provider accounts." actions={[{ label: 'Back to services', href: '/app/services' }]} />
	: !provider ? <div class="ts-resource-grid">{providers.map((item) => <ProviderCard provider={item.id} label={item.label} description={item.description} href={`/app/services/new?provider=${encodeURIComponent(item.id)}`}><p>{item.capabilities.filter((capability: any) => capability.status === 'available').map((capability: any) => capability.label).join(' · ')}</p></ProviderCard>)}</div>
	: <div class="ts-resource-grid ts-resource-grid--sidebar">
		<Panel eyebrow={provider.label} title="Connection details" description="Account identifiers remain readable metadata. Credentials are added after the connection is created." knowledgePageId={provider.knowledgePageIds[0]}>
			<form method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/services`} data-ts-submit="enhanced" data-ts-form-adapter="service-connection" data-ts-success-message="Service connected." data-scene="service.create.submit"><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="providerId" value={provider.id} /><div class="ts-form-grid"><Field label="Connection reference" name="displayName" help="A stable, provider-scoped name used by portable Platform topology. It must exactly match the topology connectionRef; database IDs never belong in Platform." required><TextInput name="displayName" placeholder={`${provider.id}-hosting-staging`} maxlength={80} required /></Field>{provider.connectionFields.map((item: any) => <Field label={item.label} name={`config.${item.key}`} help={item.description} required={item.required}><TextInput name={`config.${item.key}`} placeholder={item.placeholder} required={item.required} /></Field>)}</div><CapabilitySelector capabilities={provider.capabilities.map((capability: any) => ({ ...capability, credentialProfileId: capability.credentialProfileIds[0], credentialProfiles: capability.credentialProfileIds.map((id: string) => ({ id, label: provider.credentialProfiles.find((profile: any) => profile.id === id)?.label ?? id })) }))} /><div class="ts-form-actions"><Button type="submit">Connect service</Button><Button href="/app/services/new" variant="secondary">Choose another provider</Button></div></form>
		</Panel>
		<Panel eyebrow="Setup help" title={`Configure ${provider.label} safely`} description="Review the minimum permissions before creating provider credentials." knowledgePageId={provider.knowledgePageIds[0]}><PermissionChecklist {permissions} open />{provider.credentialProfiles.map((profile: any) => <p><strong>{profile.label}:</strong> {profile.description}</p>)}<p><a href={provider.documentationUrl} rel="noreferrer" target="_blank">Open authoritative {provider.label} setup documentation</a></p></Panel>
	</div>}
	</section>
</SettingsTemplate>
