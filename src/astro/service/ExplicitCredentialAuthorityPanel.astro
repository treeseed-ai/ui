---
import Badge from '../data/Badge.astro';
import Button from '../forms/actions/Button.astro';
import Field from '../forms/fields/Field.astro';
import TextInput from '../forms/fields/TextInput.astro';
import Panel from '../surface/Panel.astro';
import PermissionChecklist from './PermissionChecklist.astro';

interface Props {
	teamId: string;
	connectionId: string;
	profileId: string;
	title: string;
	description: string;
	permissions: string[];
	csrfToken: string;
	authority?: { scheme?: string; reference?: string; status?: string; version?: number } | null;
	suggestedEnvironmentReference: string;
}

const props = Astro.props;
const ready = props.authority?.status === 'ready';
const interactive = props.authority?.status === 'interactive-only';
---

<Panel eyebrow="Explicit credential authority" title={props.title} description={props.description} knowledgePageId="services.credentials">
	<div class="ts-badge-list">
		<Badge tone={ready ? 'success' : interactive ? 'muted' : 'warning'} size="sm">
			{ready ? 'Unattended ready' : interactive ? 'Interactive only' : 'Authority required'}
		</Badge>
		{props.authority?.scheme ? <Badge tone="muted" size="sm">{props.authority.scheme}</Badge> : null}
	</div>
	<p class="ts-text-muted ts-text-sm">
		An environment reference stores only the variable name. The token remains in the reconciled operator environment and is never copied into TreeSeed storage.
	</p>
	<form method="post"
		action={`/v1/teams/${encodeURIComponent(props.teamId)}/services/${encodeURIComponent(props.connectionId)}/credential-authorities/${encodeURIComponent(props.profileId)}`}
		data-ts-submit="enhanced" data-ts-form-adapter="provider-authority"
		data-ts-success-message="Credential authority saved.">
		<input type="hidden" name="csrfToken" value={props.csrfToken} />
		<input type="hidden" name="scheme" value="environment-reference" />
		{props.authority?.version ? <input type="hidden" name="version" value={props.authority.version} /> : null}
		<Field label="Environment variable reference" name="reference"
			help="Use a repository-scoped TREESEED_GITHUB_TOKEN_OWNER_REPOSITORY variable whenever possible." required>
			<TextInput name="reference" value={props.authority?.scheme === 'environment-reference'
				? props.authority.reference : props.suggestedEnvironmentReference} autocomplete="off" required />
		</Field>
		<Button type="submit" variant={ready ? 'secondary' : 'primary'}>{ready ? 'Update environment reference' : 'Use environment reference'}</Button>
	</form>
	<PermissionChecklist permissions={props.permissions} />
</Panel>
