---
interface Props {
	provider: string;
	label: string;
	size?: 'sm' | 'md' | 'lg';
}

const { provider, label, size = 'md' } = Astro.props as Props;
---

<span class="ts-provider-mark" data-provider={provider} data-size={size} role="img" aria-label={`${label} logo`}>
	{provider === 'github' ? (
		<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7A11.3 11.3 0 0 0 8.4 22.8c.6.1.8-.3.8-.6v-2.4c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.4-5.5-6.2 0-1.4.5-2.5 1.3-3.4-.1-.3-.6-1.6.1-3.3 0 0 1.1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.7.2 3 .1 3.3.8.9 1.3 2 1.3 3.4 0 4.8-2.9 5.9-5.6 6.2.4.4.8 1.2.8 2.3v3.4c0 .3.2.7.8.6A11.3 11.3 0 0 0 12 .7Z"/></svg>
	) : provider === 'cloudflare' ? (
		<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.1 17.9h13.7l.3-1.1c.4-1.5-.5-2.3-1.8-2.4l-.6-.1-.1-.6A5.6 5.6 0 0 0 7.8 12l-.3.7-.7-.2a3.2 3.2 0 0 0-3.9 2.3c-.4 1.6.7 3.1 2.3 3.1h1.9Zm-3.4 1.4h15.9l-.3 1H3.4c-.6 0-1-.5-.8-1 .1-.1.5 0 1.1 0Z"/></svg>
	) : provider === 'railway' ? (
		<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.2A2.2 2.2 0 0 1 5.2 3h13.6A2.2 2.2 0 0 1 21 5.2V19h-3.2l-2.1-4.2H8.3L6.2 19H3V5.2Zm3 1.2v2h12v-2H6Zm1 4.4v1.7h10v-1.7H7Z"/></svg>
	) : (
		<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5.5v5.2c0 5.1 3.4 9.6 8 11.3 4.6-1.7 8-6.2 8-11.3V5.5L12 2Zm0 4.1 4.2 1.8v2.8c0 3.2-1.7 6.1-4.2 7.5-2.5-1.4-4.2-4.3-4.2-7.5V7.9L12 6.1Z"/></svg>
	)}
</span>
