---
interface Props {
	provider: string;
	label: string;
	size?: 'sm' | 'md' | 'lg';
}

const { provider, label, size = 'md' } = Astro.props as Props;
---

<span class="ts-provider-mark" data-provider={provider} data-size={size} role="img" aria-label={`${label} logo`}>
