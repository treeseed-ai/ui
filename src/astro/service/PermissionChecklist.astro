---
interface Props {
	title?: string;
	description?: string;
	permissions: string[];
	open?: boolean;
}

const {
	title = 'Required provider permissions',
	description = 'These are the permissions declared for this connection method, not a check of your account access. Selecting tasks in TreeSeed does not grant permissions at the provider.',
	permissions,
	open = false,
} = Astro.props as Props;
---

<details class="ts-permission-checklist" open={open}>
	<summary>{title}</summary>
	<p>{description}</p>
	<ul>
		{permissions.map((permission) => <li>{permission}</li>)}
	</ul>
	<slot />
</details>
