---
interface Props {
	title?: string;
	description?: string;
	permissions: string[];
	open?: boolean;
}

const {
	title = 'Required provider permissions',
	description = 'Grant only the permissions required by the capabilities you enable.',
	permissions,
	open = false,
} = Astro.props as Props;
---

<details class="ts-permission-checklist" open={open}>
	<summary>{title}</summary>
	<p>{description}</p>
	<ul>
		{permissions.map((permission) => <li>{permission}</li>)}
	</ul>
	<slot />
</details>
