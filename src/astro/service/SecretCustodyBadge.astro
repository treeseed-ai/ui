---
import Badge from '../data/Badge.astro';

interface Props {
	mode: string;
}

const { mode } = Astro.props as Props;
const display = {
	client_encrypted_vault: { label: 'Client-encrypted', tone: 'success' },
	github_actions_secret_enclave: { label: 'Actions enclave', tone: 'info' },
	external_vault_reference: { label: 'External vault', tone: 'info' },
	metadata_only_reentry: { label: 'Re-entry required', tone: 'warning' },
}[mode] ?? { label: mode.replaceAll('_', ' '), tone: 'muted' };
---

<Badge tone={display.tone as any} size="sm">{display.label}</Badge>
