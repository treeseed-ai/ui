---
import '../../styles/app-controls.css';
import '../../styles/operations.css';
import ProductShell from '../shell/layout/ProductShell.astro';
import DeleteConfirmationModal from '../app/controls/data/DeleteConfirmationModal.astro';
import ShellIcon from '../shell/navigation/ShellIcon.astro';
import type { FeedbackContext, HelpContext } from '../../lib/foundation/contracts.ts';
import type { ThemePreference } from '../../theme/types.ts';
import type { ButtonAction, ShellNavItem } from '../types.ts';
import { SITE_SLOGAN } from '../../site-brand.ts';


interface TeamEntry {
	id: string;
	name: string;
	slug?: string;
	displayName?: string | null;
}

interface Props {
	title: string;
	description?: string;
	currentPath: string;
	teams: TeamEntry[];
	activeTeam?: TeamEntry | null;
	appearance?: ThemePreference;
	navItems?: ShellNavItem[];
	quickActions?: ButtonAction[];
	helpContext?: HelpContext;
	feedbackContext?: FeedbackContext;
	appearanceEndpoint?: string;
	contentOwnsPageHeader?: boolean;
}

const {
	title,
	description = 'Set up teams, hosts, projects, capacity, work, and knowledge.',
	currentPath,
	teams,
	activeTeam = null,
	appearance = { scheme: 'fern', mode: 'system' },
	navItems: providedNavItems,
	quickActions: providedQuickActions,
	helpContext,
	feedbackContext,
	appearanceEndpoint = '/v1/auth/web/appearance',
	contentOwnsPageHeader = false,
} = Astro.props as Props;

const railItems = providedNavItems ?? [
	{ label: 'Start', href: '/app/', icon: 'start' as const },
	{ label: 'Services', href: '/app/services', icon: 'services' as const },
	{ label: 'Projects', href: '/app/projects', icon: 'projects' as const },
	{ label: 'Capacity', href: '/app/capacity/providers', icon: 'capacity' as const },
	{ label: 'Work', href: '/app/work', icon: 'work' as const },
	{ label: 'Knowledge', href: '/app/knowledge/artifacts', icon: 'knowledge' as const },
];

const quickActions = providedQuickActions ?? [
	activeTeam
		? { label: 'New project', href: '/app/projects/new', variant: 'primary' as const, icon: 'create' as const }
		: { label: 'New team', href: '/app/teams/new', variant: 'primary' as const, icon: 'create' as const },
];
const accountActions: ButtonAction[] = [
	{ label: 'Account', href: '/app/account', variant: 'secondary', icon: 'account' },
	{ label: 'Sign out', href: '/v1/auth/logout?returnTo=/', variant: 'secondary', reload: true, icon: 'sign-out', iconOnly: true },
];
const teamOptions = teams.map((team) => ({
	id: team.id,
	label: team.displayName ?? team.name ?? team.slug ?? team.id,
}));
---

<ProductShell
	title={title}
	description={description}
	currentPath={currentPath}
	appearance={appearance}
	contentOwnsPageHeader={contentOwnsPageHeader}
	brand={{
		name: 'TreeSeed Platform',
		tag: SITE_SLOGAN,
		href: '/app/',
		logoSrc: '/logo.svg',
		logoAlt: '',
	}}
	navItems={railItems}
	quickActions={quickActions}
	accountActions={accountActions}
	helpContext={helpContext}
	feedbackContext={feedbackContext}
>
	<div slot="railContext" class="ts-team-switcher" data-appearance-endpoint={appearanceEndpoint}>
		<div class="ts-section__eyebrow">Team</div>
		{teams.length > 0 ? (
			<form class="ts-team-selector" aria-label="Active team" data-team-switcher>
				<label class="ts-field ts-team-selector__label">
					<select class="ts-control" name="teamId" aria-label="Active team">
						{teamOptions.map((team) => (
							<option value={team.id} selected={team.id === activeTeam?.id}>{team.label}</option>
						))}
					</select>
				</label>
				<a class="ts-icon-button ts-team-manage-button" href="/app/teams" title="Manage teams" aria-label="Manage teams">
					<ShellIcon name="teams" />
				</a>
			</form>
		) : (
			<a class="ts-create-team-button" href="/app/teams/new" title="Create team" aria-label="Create team">
				<ShellIcon name="create" />
				<span class="ts-team-operations__label">Create team</span>
			</a>
		)}
	</div>
	<slot />
	<DeleteConfirmationModal slot="modal" />
</ProductShell>

<script>
	document.querySelectorAll('[data-team-switcher]').forEach((form) => {
		const select = (form as HTMLFormElement).elements.namedItem('teamId') as HTMLSelectElement | null;
		select?.addEventListener('change', () => {
			const url = new URL(window.location.href);
			url.searchParams.delete('teamId');
			document.cookie = `treeseed_active_team=${encodeURIComponent(select.value)}; path=/app; max-age=31536000; SameSite=Lax`;
			window.location.href = url.toString();
		});
	});
</script>

<script>
	import { sendFormRequest } from '../../forms-client.ts';

	const bindingKey = '__treeseedAuthenticatedAppearanceSyncBound';
	const syncWindow = window as unknown as Record<string, unknown>;
	if (!syncWindow[bindingKey]) {
		syncWindow[bindingKey] = true;
		window.addEventListener('treeseed:theme-change', (event) => {
			const detail = (event as CustomEvent).detail || {};
			if (detail.persist !== true || !detail.scheme || !detail.mode) return;
			const endpoint = document.querySelector<HTMLElement>('[data-appearance-endpoint]')?.dataset.appearanceEndpoint;
			if (!endpoint) return;
			void sendFormRequest({
				url: endpoint,
				init: {
					method: 'PATCH',
					headers: { accept: 'application/json', 'content-type': 'application/json', 'x-treeseed-csrf': document.cookie.split('; ').find((entry) => entry.startsWith('ts_csrf='))?.split('=').slice(1).join('=') || '' },
					body: JSON.stringify({
						colorScheme: detail.scheme,
						themeMode: detail.mode,
						contentThemeOverlayEnabled: detail.workspace?.enabled === true,
						contentThemeOverlayScheme: detail.workspace?.scheme,
						contentThemeOverlayMode: detail.workspace?.mode,
					}),
					keepalive: true,
				},
			}).catch(() => {
				// Local cookies retain the immediate preference; the next change can retry persistence.
			});
		});
	}
</script>
