---
import ActionBar from '../layout/ActionBar.astro';
import PageHeader from '../layout/PageHeader.astro';
import SurfaceTabs from '../shell/navigation/SurfaceTabs.astro';
import HelpTrigger from '../help/HelpTrigger.astro';
import type { ResolvedAction } from '../../lib/foundation/contracts.ts';

interface SectionLink {
	id?: string;
	label: string;
	href: string;
	current?: boolean;
}

interface Props {
	title: string;
	description?: string;
	actions?: ResolvedAction[];
	sections?: SectionLink[];
	class?: string;
	knowledgePageId?: string;
}

const {
	title,
	description,
	actions = [],
	sections = [],
	class: className,
	knowledgePageId,
} = Astro.props as Props;
const tabItems = sections.map((section) => ({
	id: section.id ?? section.href,
	label: section.label,
	href: section.href,
}));
const currentSection = sections.find((section) => section.current) ?? sections[0];
---

<section class:list={['ts-template ts-template--settings', className]}>
	<PageHeader title={title} description={description}>
		<Fragment slot="actions">
			{knowledgePageId ? <HelpTrigger knowledgePageId={knowledgePageId} label={`Help with ${title}`} /> : null}
			<ActionBar actions={actions} />
		</Fragment>
	</PageHeader>
	<div class="ts-template__main">
		{sections.length > 0 && currentSection ? (
			<SurfaceTabs
				items={tabItems}
				current={currentSection.id ?? currentSection.href}
				label="Settings sections"
				wrap
			/>
		) : null}
		<div class="ts-template__body">
			<slot />
		</div>
	</div>
</section>
