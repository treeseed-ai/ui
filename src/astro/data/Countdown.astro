---
import Timestamp from './Timestamp.astro';
import { timestampDate } from '../../timestamps.ts';

interface Props {
	target: string | number | Date;
	startedAt?: string | number | Date;
	timeZone?: string;
	label?: string;
	completeLabel?: string;
	class?: string;
}

const {
	target,
	startedAt,
	timeZone,
	label = 'Time remaining',
	completeLabel = 'Window ended',
	class: className,
} = Astro.props as Props;
const targetDate = timestampDate(target);
const startedDate = startedAt === undefined ? null : timestampDate(startedAt);
const targetIso = targetDate?.toISOString() ?? '';
const startedIso = startedDate?.toISOString() ?? '';
const initialRemaining = targetDate ? Math.max(0, targetDate.getTime() - Date.now()) : 0;

function durationLabel(milliseconds: number) {
	if (milliseconds <= 0) return completeLabel;
	const totalMinutes = Math.ceil(milliseconds / 60_000);
	const days = Math.floor(totalMinutes / 1_440);
	const hours = Math.floor((totalMinutes % 1_440) / 60);
	const minutes = totalMinutes % 60;
	if (days > 0) return `${days}d ${hours}h`;
	if (hours > 0) return `${hours}h ${minutes}m`;
	return `${minutes}m`;
}
---

<section
	class:list={['ts-countdown', className]}
	data-ts-countdown
	data-target={targetIso}
	data-started-at={startedIso}
	data-complete-label={completeLabel}
	aria-label={label}
>
	<div class="ts-countdown__heading">
		<span>{label}</span>
		<strong data-ts-countdown-value>{durationLabel(initialRemaining)}</strong>
	</div>
	<div
		class="ts-countdown__track"
		role="progressbar"
		aria-label={label}
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow="100"
	>
		<span data-ts-countdown-progress></span>
	</div>
	<p>Deadline <Timestamp value={target} timeZone={timeZone} /></p>
</section>

<script>
	const durationText = (milliseconds: number, completeLabel: string) => {
		if (milliseconds <= 0) return completeLabel;
		const totalMinutes = Math.ceil(milliseconds / 60_000);
		const days = Math.floor(totalMinutes / 1440);
		const hours = Math.floor((totalMinutes % 1440) / 60);
		const minutes = totalMinutes % 60;
		if (days > 0) return `${days}d ${hours}h`;
		if (hours > 0) return `${hours}h ${minutes}m`;
		return `${minutes}m`;
	};

	const updateCountdowns = () => {
		document.querySelectorAll<HTMLElement>('[data-ts-countdown]').forEach((element) => {
			const target = Date.parse(element.dataset.target ?? '');
			if (!Number.isFinite(target)) return;
			const startedAt = Date.parse(element.dataset.startedAt ?? '');
			const remaining = Math.max(0, target - Date.now());
			const value = element.querySelector<HTMLElement>('[data-ts-countdown-value]');
			if (value) value.textContent = durationText(remaining, element.dataset.completeLabel ?? 'Window ended');
			const total = Number.isFinite(startedAt) ? Math.max(1, target - startedAt) : Math.max(1, remaining);
			const percent = Math.max(0, Math.min(100, (remaining / total) * 100));
			const progress = element.querySelector<HTMLElement>('[data-ts-countdown-progress]');
			if (progress) progress.style.width = `${percent}%`;
			const track = element.querySelector<HTMLElement>('[role="progressbar"]');
			track?.setAttribute('aria-valuenow', String(Math.round(percent)));
			element.dataset.complete = remaining <= 0 ? 'true' : 'false';
		});
	};

	const installCountdowns = () => {
		updateCountdowns();
		const runtime = window as Window & { __tsCountdownTimer?: number };
		if (runtime.__tsCountdownTimer) window.clearInterval(runtime.__tsCountdownTimer);
		runtime.__tsCountdownTimer = window.setInterval(updateCountdowns, 60_000);
	};

	document.addEventListener('astro:page-load', installCountdowns);
	document.addEventListener('treeseed:content-updated', installCountdowns);
	installCountdowns();
</script>
