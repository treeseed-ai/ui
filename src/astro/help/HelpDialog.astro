---
import type { FeedbackContext, HelpContext } from '../../lib/foundation/contracts.ts';
import HelpArticle from './HelpArticle.astro';
import HelpSearch from './HelpSearch.astro';
import HelpKnowledgeNavigation from './HelpKnowledgeNavigation.astro';

interface Props {
	id: string;
	context: HelpContext;
	feedbackTargetId?: string;
	feedbackContext?: FeedbackContext;
}

const { id, context, feedbackTargetId, feedbackContext } = Astro.props as Props;
const primaryPage = context.knowledgePages?.[0] ?? null;
const clientConfig = {
	pageEndpoint: context.pageEndpoint ?? '/v1/knowledge/pages/{pageId}',
	searchEndpoint: context.searchEndpoint ?? '/v1/knowledge/search',
	searchScope: context.searchScope,
	capabilityId: context.capabilityId,
	teamId: context.teamId,
	projectId: context.projectId,
	locale: context.locale ?? 'en',
};
---

<dialog
	id={id}
	class="ts-help-dialog"
	aria-labelledby={`${id}-title`}
	data-ts-help-dialog={id}
	data-ts-dialog-backdrop-close
	data-ts-help-current-knowledge-page={primaryPage?.id}
>
	<div class="ts-help-dialog__surface">
		<header class="ts-help-dialog__header">
			<div class="ts-help-dialog__identity">
				<h1 id={`${id}-title`}>TreeSeed Help</h1>
			</div>
			<HelpSearch placeholder={context.searchPlaceholder} />
			<button class="ts-help-dialog__close" type="button" aria-label="Close help" data-ts-help-close data-dialog-close data-ts-dialog-initial-focus>Close</button>
		</header>
		<div class="ts-help-dialog__layout">
			<HelpArticle page={primaryPage} />
			<aside class="ts-help-dialog__rail">
				<HelpKnowledgeNavigation pages={context.relatedDocs} currentKnowledgePageId={primaryPage?.id} targetId={id} />
			</aside>
		</div>
		{feedbackTargetId && feedbackContext ? (
			<footer class="ts-help-dialog__footer">
				<button
					class="ts-button"
					data-variant="secondary"
					type="button"
					data-ts-feedback-open={feedbackTargetId}
					data-ts-feedback-context-patch={JSON.stringify({
						source: 'help',
						knowledgePageId: primaryPage?.id ?? context.knowledgePageIds[0],
						knowledgePageTitle: primaryPage?.title ?? context.summary,
						capabilityId: context.capabilityId,
						routePattern: context.routePattern,
						canonicalPath: context.canonicalPath,
						resourceType: context.resourceType,
						resourceId: context.resourceId,
					})}
				>
					Send feedback about this help
				</button>
			</footer>
		) : null}
	</div>
	<script is:inline type="application/json" data-ts-help-client-config set:html={JSON.stringify(clientConfig)} />
</dialog>

<script>
	import { initializeHelpDialogs } from '../../lib/help/dialog.ts';
	initializeHelpDialogs();
</script>
