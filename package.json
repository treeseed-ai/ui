{
  "name": "@treeseed-cordis/ui",
  "version": "0.0.0-cordis.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    ".": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./source-policy": {
      "types": "./dist/src/source-policy.d.ts",
      "default": "./dist/src/source-policy.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun scripts/tooling.ts check",
    "build": "bun scripts/tooling.ts build",
    "test:unit": "bun test ./tests --test-name-pattern '^unit:'",
    "test:integration": "bun test ./tests --test-name-pattern '^integration:'",
    "test:smoke": "bun test ./tests --test-name-pattern '^smoke:'",
    "verify": "bun run check && bun run build && bun run test:unit && bun run test:integration && bun run test:smoke"
  },
  "peerDependencies": {
    "@treeseed-cordis/sdk": "0.0.0-cordis.5",
    "react": "19.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz",
    "react": "19.3.1",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1"
  },
  "cordisCandidate": {
    "sdk": {
      "repository": "https://github.com/treeseed-ai/sdk.git",
      "commit": "4bb8f089a2c9cd9604f4b02e9fc27816f547eef2",
      "sha256": "9e94261c6b05654bf5bbd74b822e3cb9bc6b24a99976201a3a81fe0700882617"
    }
  }
}
