{
  "name": "@treeseed/ui",
  "version": "0.12.18-rc.11",
  "description": "Reusable TreeSeed UI components, themes, and component sandbox.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/treeseed-ai/ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "astro dev --root sandbox",
    "build": "vite build && node --import tsx ./scripts/support/copy-assets.ts",
    "build:dist": "npm run build",
    "check:file-lengths": "node --import tsx ./scripts/support/check-file-lengths.ts && npm run check:file-architecture",
    "check:file-architecture": "node --import tsx ./scripts/support/check-file-architecture.ts",
    "sandbox:build": "astro build --root sandbox && node --import tsx ./scripts/build/build-sandbox-worker.ts",
    "sandbox:serve": "node --import tsx ./scripts/support/serve-sandbox.ts",
    "preview": "astro preview --root sandbox",
    "check": "npm run check:file-lengths && tsc --noEmit && astro check --root sandbox",
    "prepack": "npm run build",
    "prepare": "node --import tsx ./scripts/support/prepare.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:e2e": "node --import tsx ./scripts/support/run-playwright.ts test",
    "test:all": "npm run build && npm run test && npm run test:e2e",
    "verify:direct": "npm run release:verify",
    "verify:local": "npm run verify:direct",
    "verify": "npm run verify:direct",
    "release:setup": "npm ci && npx playwright install --with-deps chromium",
    "release:check-tag": "node --import tsx ./scripts/packages/assert-release-tag-version.ts",
    "release:verify": "node --import tsx ./scripts/packages/release-verify.ts",
    "release:custody": "node --import tsx ./scripts/packages/release-custody.ts",
    "release:publish": "node --import tsx ./scripts/packages/publish-package.ts",
    "audit:market-parity": "node --import tsx ./scripts/support/audit-market-parity.ts"
  },
